# Copier ce fichier en .env.prod.local sur le serveur (jamais commité) et renseigner de vraies valeurs.

APP_SECRET=change-me-with-a-random-string
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-with-a-strong-password
POSTGRES_DB=app
POSTGRES_VERSION=16

# DSN Symfony Mailer (ex: smtp://user:pass@smtp.example.com:587) pour l'envoi des
# emails d'invitation aux licenciés. Laisser en null://null désactive l'envoi réel.
MAILER_DSN=null://null
MAILER_FROM=contact@axioweb.fr
