        <main{{ app.user ? '' : ' class="main-public"' }}>
            {% if app.user and app.user.motDePasseExpose %}
                <p class="flash-error">
                    ⚠️ Votre mot de passe a été trouvé dans une base de données de fuites connues.
                    Nous vous recommandons de le
                    <a href="{{ path('app_change_password') }}">changer dès maintenant</a>.
                </p>
            {% endif %}
            {% for message in app.flashes('success') %}
                <p class="flash-success">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p class="flash-error">{{ message }}</p>
            {% endfor %}
            {% block body %}{% endblock %}
        </main>

        <footer style="text-align: center; padding: 1.5rem 1rem; font-size: 0.85rem; color: var(--color-text-muted);">
            <a href="{{ path('app_documentation') }}">Documentation</a>
            ·
            <a href="{{ path('app_confidentialite') }}">Politique de confidentialité</a>
            ·
            <a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
            ·
            <a href="{{ path('app_registre_traitements') }}">Registre des traitements</a>
        </footer>

        {% if app.user %}
                </div>
            </div>
        {% endif %}

        <script>
            function definirTheme(mode) {
                if ('system' === mode) {
                    document.documentElement.removeAttribute('data-theme');
                    localStorage.removeItem('axiobad-theme');
                } else {
                    document.documentElement.setAttribute('data-theme', mode);
                    localStorage.setItem('axiobad-theme', mode);
                }
                majBoutonsTheme(mode);
            }
            function majBoutonsTheme(mode) {
                ['light', 'dark', 'system'].forEach(function (m) {
                    var bouton = document.getElementById('btn-theme-' + m);
                    if (bouton) { bouton.classList.toggle('active', m === mode); }
                });
            }
            majBoutonsTheme(localStorage.getItem('axiobad-theme') || 'dark');

            function ouvrirMenuMobile() {
                document.getElementById('app').classList.add('mobile-open');
                document.body.style.overflow = 'hidden';
            }
            function fermerMenuMobile() {
                document.getElementById('app').classList.remove('mobile-open');
                document.body.style.overflow = '';
            }

            function basculerReductionMenu() {
                var app = document.getElementById('app');
                app.classList.toggle('collapsed');
                try { localStorage.setItem('axiobad-menu-reduit', app.classList.contains('collapsed') ? '1' : '0'); } catch (e) {}
            }
            (function () {
                try {
                    if ('1' === localStorage.getItem('axiobad-menu-reduit') && window.innerWidth > 900) {
                        document.getElementById('app').classList.add('collapsed');
                    }
                } catch (e) {}
            })();

            document.addEventListener('click', function (event) {
                var menu = document.getElementById('compte-menu');
                if (menu && menu.classList.contains('ouvert') && !menu.contains(event.target)) {
                    menu.classList.remove('ouvert');
                }
            });

            // Ferme le tiroir mobile dès qu'on choisit un lien du menu, pour un retour visuel
            // immédiat (la navigation elle-même peut prendre un instant sur mobile).
            document.querySelectorAll('.sidebar .nav-item').forEach(function (lien) {
                lien.addEventListener('click', fermerMenuMobile);
            });
        </script>

        {% block javascripts %}
        {% endblock %}

        <script>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('{{ asset('sw.js') }}').catch(function () {});
                });
            }
        </script>
    </body>
</html>
