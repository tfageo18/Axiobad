<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <script>
            // Applique le thème avant le premier rendu, pour éviter un flash de la mauvaise
            // palette. Thème sombre par défaut tant que l'utilisateur n'a pas fait de choix
            // explicite (clair, ou suivre le système).
            (function () {
                try {
                    var theme = localStorage.getItem('axiobad-theme') || 'dark';
                    if ('light' === theme || 'dark' === theme) {
                        document.documentElement.setAttribute('data-theme', theme);
                    }
                } catch (e) {}
            })();
        </script>
        <title>{% block title %}Axiobad{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        <link rel="apple-touch-icon" href="{{ asset('icons/apple-touch-icon.png') }}">
        <meta name="theme-color" content="#151a24">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content="Axiobad">
        {% block stylesheets %}
        <style>
            :root {
                /* Fond légèrement teinté plutôt que blanc pur — les surfaces (cartes, tableaux)
                   se détachent dessus au lieu de se fondre dedans. */
                --color-bg: #f1f3fa;
                --color-surface: #ffffff;
                --color-surface-2: #eaeef9;
                --color-border: #dde2f1;
                --color-text: #14171f;
                --color-text-muted: #5c6577;
                --color-text-faint: #8991a3;

                --color-primary: #2c56d6;
                --color-primary-dark: #1e3fae;
                --color-primary-soft: #e7edfd;
                --color-accent: #f97316;
                --color-accent-dark: #ea580c;
                --color-success: #178a4c;
                --color-success-bg: #e3f6ec;
                --color-error: #c22a2a;
                --color-error-bg: #fbe6e6;
                --color-warning: #b5680a;
                --color-warning-bg: #fbeed9;

                --radius: 12px;
                --shadow: 0 1px 3px rgba(20, 30, 60, 0.08), 0 1px 2px rgba(20, 30, 60, 0.06);

                --sidebar-w: 260px;
                --sidebar-w-collapsed: 72px;
            }

            @media (prefers-color-scheme: dark) {
                :root:not([data-theme="light"]) {
                    --color-bg: #0d1016;
                    --color-surface: #151a24;
                    --color-surface-2: #1b2231;
                    --color-border: #262f42;
                    --color-text: #e9ecf6;
                    --color-text-muted: #8b96ac;
                    --color-text-faint: #5d667a;

                    --color-primary: #6b8cff;
                    --color-primary-dark: #90a9ff;
                    --color-primary-soft: #1c2745;
                    --color-accent: #fb923c;
                    --color-accent-dark: #fdba74;
                    --color-success: #3ecb82;
                    --color-success-bg: #0f2a1c;
                    --color-error: #ef5757;
                    --color-error-bg: #2f1414;
                    --color-warning: #e2a53d;
                    --color-warning-bg: #302108;

                    --shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
                }
            }

            :root[data-theme="dark"] {
                --color-bg: #0d1016;
                --color-surface: #151a24;
                --color-surface-2: #1b2231;
                --color-border: #262f42;
                --color-text: #e9ecf6;
                --color-text-muted: #8b96ac;
                --color-text-faint: #5d667a;

                --color-primary: #6b8cff;
                --color-primary-dark: #90a9ff;
                --color-primary-soft: #1c2745;
                --color-accent: #fb923c;
                --color-accent-dark: #fdba74;
                --color-success: #3ecb82;
                --color-success-bg: #0f2a1c;
                --color-error: #ef5757;
                --color-error-bg: #2f1414;
                --color-warning: #e2a53d;
                --color-warning-bg: #302108;

                --shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
            }

            * { box-sizing: border-box; }
            html { color-scheme: light dark; }

            body {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                margin: 0;
                background: var(--color-bg);
                color: var(--color-text);
                line-height: 1.5;
            }

            h1, h2, h3 {
                font-weight: 800;
                letter-spacing: -0.01em;
                color: var(--color-text);
                text-wrap: balance;
            }
            h1 { font-size: 1.6rem; margin: 0 0 1.25rem; }
            h2 { font-size: 1.2rem; margin: 2rem 0 0.75rem; }

            a { color: var(--color-primary); font-weight: 500; }

            /* ============ APP SHELL (utilisateur connecté) ============ */
            .app { display: flex; min-height: 100vh; min-height: 100dvh; }

            .sidebar {
                width: var(--sidebar-w);
                flex: 0 0 auto;
                background: var(--color-surface);
                border-right: 1px solid var(--color-border);
                display: flex;
                flex-direction: column;
                position: sticky;
                top: 0;
                height: 100vh;
                height: 100dvh;
                overflow-y: auto;
                overscroll-behavior: contain;
                -webkit-overflow-scrolling: touch;
                padding: 1rem 0.75rem;
                transition: width 0.15s ease;
                z-index: 30;
            }
            .app.collapsed .sidebar { width: var(--sidebar-w-collapsed); }

            .sidebar-header {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                padding: 0.4rem 0.5rem 1rem;
                border-bottom: 1px solid var(--color-border);
                margin-bottom: 0.9rem;
                text-decoration: none;
            }
            .sidebar-header img { width: 30px; height: 30px; flex: 0 0 auto; }
            .sidebar-header .brand-text { font-weight: 800; font-size: 1.05rem; color: var(--color-text); letter-spacing: -0.01em; }
            .app.collapsed .sidebar-header { justify-content: center; padding-left: 0; padding-right: 0; }
            .app.collapsed .brand-text, .app.collapsed .nav-label, .app.collapsed .nav-group-title,
            .app.collapsed .sidebar-user-info, .app.collapsed .badge-count,
            .app.collapsed .nav-subgroup-title span, .app.collapsed .nav-subgroup-chevron { display: none; }

            .nav-group { margin-bottom: 1rem; }
            .nav-group-title {
                font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em;
                color: var(--color-text-faint); padding: 0 0.6rem; margin-bottom: 0.3rem;
            }
            .nav-item {
                display: flex; align-items: center; gap: 0.7rem;
                padding: 0.5rem 0.6rem; border-radius: 8px;
                color: var(--color-text-muted); font-weight: 600; font-size: 0.87rem;
                text-decoration: none; white-space: nowrap; overflow: hidden;
            }
            .nav-item:hover { background: var(--color-surface-2); color: var(--color-text); }
            .nav-item.active { background: var(--color-primary-soft); color: var(--color-primary-dark); }
            .nav-item svg { flex: 0 0 auto; width: 18px; height: 18px; }
            .app.collapsed .nav-item { justify-content: center; padding: 0.55rem; }
            .nav-subgroup { margin-bottom: 0.15rem; }
            .nav-subgroup-title {
                display: flex; align-items: center; gap: 0.5rem; cursor: pointer; list-style: none;
                padding: 0.4rem 0.6rem; border-radius: 8px;
                color: var(--color-text-muted); font-weight: 700; font-size: 0.8rem;
                user-select: none;
            }
            .nav-subgroup-title::-webkit-details-marker { display: none; }
            .nav-subgroup-title:hover { background: var(--color-surface-2); color: var(--color-text); }
            .nav-subgroup-title .nav-subgroup-chevron { flex: 0 0 auto; width: 14px; height: 14px; transition: transform 0.15s ease; }
            .nav-subgroup[open] > .nav-subgroup-title .nav-subgroup-chevron { transform: rotate(90deg); }
            .nav-subgroup .nav-item { padding-left: 1.4rem; }
            .app.collapsed .nav-subgroup-title { justify-content: center; padding: 0.55rem; }
            .app.collapsed .nav-subgroup .nav-item { padding-left: 0.55rem; }

            .sidebar-footer {
                margin-top: auto; padding-top: 0.8rem; border-top: 1px solid var(--color-border);
                position: relative;
            }
            .sidebar-footer-bouton {
                display: flex; align-items: center; gap: 0.6rem; width: 100%;
                background: none; border: none; cursor: pointer; padding: 0.4rem 0.6rem 0.4rem 0;
                border-radius: 8px; font-family: inherit; text-align: left;
            }
            .sidebar-footer-bouton:hover { background: var(--color-surface-2); }
            .app.collapsed .sidebar-footer-bouton { justify-content: center; padding-right: 0; }
            .avatar {
                width: 32px; height: 32px; border-radius: 50%; flex: 0 0 auto;
                background: var(--color-primary-soft); color: var(--color-primary-dark);
                display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem;
            }
            .sidebar-user-info { overflow: hidden; flex: 1; }
            .sidebar-user-info div:first-child { font-weight: 700; font-size: 0.84rem; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
            .sidebar-user-info div:last-child { font-size: 0.72rem; color: var(--color-text-muted); }

            .compte-menu-liste {
                display: none;
                position: absolute;
                left: 0.5rem; right: 0.5rem;
                bottom: calc(100% + 0.4rem);
                background: var(--color-surface);
                border: 1px solid var(--color-border);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                overflow: hidden;
                z-index: 40;
            }
            .compte-menu.ouvert .compte-menu-liste { display: block; }
            .compte-menu-liste a, .compte-menu-liste button {
                display: block; width: 100%; text-align: left;
                padding: 0.65rem 1rem; color: var(--color-text); text-decoration: none;
                background: none; border: none; font-family: inherit; font-size: 0.88rem;
                font-weight: 500; cursor: pointer; border-radius: 0;
            }
            .compte-menu-liste a:hover, .compte-menu-liste button:hover { background: var(--color-surface-2); }
            .compte-menu-liste .deconnexion { color: var(--color-error); }

            /* ============ TOPBAR ============ */
            .app-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
            .topbar {
                display: flex; align-items: center; justify-content: space-between; gap: 1rem;
                padding: 0.75rem 1.5rem;
                border-bottom: 1px solid var(--color-border);
                position: sticky; top: 0; background: var(--color-bg);
                z-index: 10;
            }
            .topbar-actions { display: flex; align-items: center; gap: 0.5rem; }
            .icon-btn {
                width: 34px; height: 34px; border-radius: 8px;
                border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text-muted);
                display: none; align-items: center; justify-content: center; cursor: pointer;
            }
            .icon-btn:hover { background: var(--color-surface-2); color: var(--color-text); }
            .icon-btn svg { flex: 0 0 auto; width: 17px; height: 17px; }

            .theme-toggle {
                display: flex; align-items: center; background: var(--color-surface-2); border-radius: 999px;
                padding: 3px; border: 1px solid var(--color-border);
            }
            .theme-toggle button {
                border: none; background: transparent; width: 28px; height: 26px; border-radius: 999px;
                display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--color-text-muted);
                padding: 0;
            }
            .theme-toggle button svg { flex: 0 0 auto; width: 14px; height: 14px; }
            .theme-toggle button.active { background: var(--color-surface); color: var(--color-primary); box-shadow: 0 1px 2px rgba(0,0,0,0.08); }

            .topbar-public { padding: 0.9rem 1.5rem; justify-content: space-between; }
            .topbar-public .brand { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; }
            .topbar-public .brand img { width: 28px; height: 28px; }
            .topbar-public .brand span { color: var(--color-text); font-weight: 800; font-size: 1.1rem; letter-spacing: -0.02em; }
            .topbar-public .user-link {
                color: #fff; background: var(--color-primary); text-decoration: none; font-weight: 600;
                font-size: 0.88rem; padding: 0.45rem 0.9rem; border-radius: 999px;
            }
            .topbar-public .user-link:hover { background: var(--color-primary-dark); }

            main { padding: 1.75rem; max-width: 1200px; }
            .main-public { padding: 1.75rem; max-width: 720px; margin: 0 auto; width: 100%; }

            .flash-success, .flash-error {
                padding: 0.75rem 1rem;
                border-radius: var(--radius);
                margin-bottom: 1rem;
                font-size: 0.92rem;
                font-weight: 500;
                border-left: 4px solid;
            }
            .flash-success { background: var(--color-success-bg); color: var(--color-success); border-color: var(--color-success); }
            .flash-error { background: var(--color-error-bg); color: var(--color-error); border-color: var(--color-error); }

            .demo-banner {
                background: var(--color-warning-bg);
                border: 1px solid var(--color-warning);
                border-radius: var(--radius);
                padding: 1rem 1.25rem;
                margin-bottom: 1.5rem;
            }
            .demo-banner p { margin: 0 0 0.75rem; color: var(--color-warning); }
            .demo-banner code {
                background: var(--color-surface-2);
                padding: 0.15rem 0.4rem;
                border-radius: 4px;
                font-size: 0.85em;
                word-break: break-all;
            }
            /* Cartes empilées plutôt qu'un tableau : lisible sur mobile sans défilement
               horizontal ni texte écrasé (emails/mots de passe longs). */
            .demo-accounts { display: flex; flex-direction: column; gap: 0.6rem; }
            .demo-account {
                background: var(--color-surface);
                border: 1px solid var(--color-border);
                border-radius: var(--radius);
                padding: 0.7rem 0.9rem;
            }
            .demo-account-role { font-weight: 700; margin-bottom: 0.4rem; }
            .demo-account-champ {
                display: flex;
                flex-wrap: wrap;
                align-items: baseline;
                gap: 0.4rem;
                font-size: 0.9rem;
                padding: 0.15rem 0;
            }
            .demo-account-champ span { color: var(--color-text-muted); min-width: 5.5rem; }

            table {
                border-collapse: separate;
                border-spacing: 0;
                width: 100%;
                background: var(--color-surface);
                border-radius: var(--radius);
                overflow: hidden;
                box-shadow: var(--shadow);
                margin-bottom: 1.5rem;
                border: 1px solid var(--color-border);
            }
            th, td {
                padding: 0.7rem 1rem;
                text-align: left;
                border-bottom: 1px solid var(--color-border);
                font-size: 0.92rem;
            }
            th {
                background: var(--color-surface-2);
                color: var(--color-text-muted);
                font-weight: 700;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }
            tbody tr:last-child td { border-bottom: none; }
            tbody tr:hover { background: var(--color-surface-2); }

            form { margin-bottom: 0; }
            form > div { margin-bottom: 1rem; }
            label {
                display: block;
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--color-text-muted);
                margin-bottom: 0.3rem;
            }
            input[type="text"], input[type="email"], input[type="password"], input[type="tel"],
            input[type="number"], input[type="date"], input[type="time"], input[type="file"],
            input[type="url"], input[type="search"],
            select, textarea {
                width: 100%;
                max-width: 420px;
                padding: 0.55rem 0.75rem;
                border: 1px solid var(--color-border);
                border-radius: 8px;
                font-size: 0.92rem;
                font-family: inherit;
                background: var(--color-surface);
                color: var(--color-text);
            }
            input:focus, select:focus, textarea:focus {
                outline: none;
                border-color: var(--color-primary);
                box-shadow: 0 0 0 3px var(--color-primary-soft);
            }
            textarea { max-width: 100%; min-height: 5rem; }
            input[type="checkbox"] { width: auto; margin-right: 0.4rem; }

            button, input[type="submit"] {
                background: var(--color-primary);
                color: #fff;
                border: none;
                padding: 0.55rem 1.1rem;
                border-radius: 8px;
                font-size: 0.88rem;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.15s ease, transform 0.05s ease;
            }
            button:hover, input[type="submit"]:hover { background: var(--color-primary-dark); }
            button:active { transform: scale(0.98); }

            .presence-form { display: flex; gap: 0.5rem; }
            .btn-presence {
                background: var(--color-surface);
                color: var(--color-text);
                border: 2px solid var(--color-border);
            }
            .btn-presence:hover { background: var(--color-surface-2); }
            .btn-presence.selectionne {
                border-color: transparent;
                cursor: default;
                box-shadow: inset 0 0 0 2px currentColor;
            }
            .btn-presence.selectionne:hover { background: inherit; }
            .btn-presence-oui.selectionne {
                background: var(--color-success-bg);
                color: var(--color-success);
            }
            .btn-presence-non.selectionne {
                background: var(--color-error-bg);
                color: var(--color-error);
            }

            a[href*="supprimer"], form[action*="supprimer"] button {
                background: transparent;
                color: var(--color-error);
                border: 1px solid var(--color-error-bg);
            }
            form[action*="supprimer"] button:hover { background: var(--color-error-bg); }

            a[href*="/modifier"] {
                display: inline-block;
                background: var(--color-primary);
                color: #fff;
                padding: 0.4rem 0.8rem;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 600;
            }
            a[href*="/modifier"]:hover { background: var(--color-primary-dark); }

            .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

            .badge-inactif { background: var(--color-error-bg); color: var(--color-error); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.78rem; font-weight: 700; }
            .badge-actif { background: var(--color-success-bg); color: var(--color-success); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.78rem; font-weight: 700; }
            tr.ligne-inactive { opacity: 0.55; }

            .btn-cta {
                display: inline-block;
                background: var(--color-accent);
                color: #fff;
                padding: 0.5rem 1rem;
                border-radius: 8px;
                text-decoration: none;
                font-weight: 600;
                margin-bottom: 0.5rem;
            }
            .btn-cta:hover { background: var(--color-accent-dark); }

            .calendrier { box-shadow: var(--shadow); min-width: 800px; }
            .calendrier th { background: var(--color-primary); color: #fff; }
            .calendrier .hors-mois { background: var(--color-surface-2) !important; }
            .creneau-cal {
                background: var(--color-primary-soft);
                border: 1px solid var(--color-border) !important;
            }
            .creneau-cal.creneau-annule {
                background: var(--color-surface-2);
                border: 1px solid var(--color-border) !important;
                opacity: 0.75;
            }
            .agenda-creneau.creneau-annule { opacity: 0.7; }

            td a, td form { margin-right: 0.35rem; }
            td a:last-child { margin-right: 0; }

            @media (max-width: 900px) {
                .app.mobile-closed .sidebar { display: none; }
                .app { position: relative; }
                .sidebar {
                    position: fixed; left: 0; top: 0; width: var(--sidebar-w) !important;
                }
                .app:not(.mobile-open) .sidebar { transform: translateX(-100%); }
                .app.mobile-open .sidebar { transform: translateX(0); box-shadow: var(--shadow); }
                .sidebar { transition: transform 0.2s ease; }
                .scrim { display: none; position: fixed; inset: 0; background: rgba(10,12,18,0.45); z-index: 25; }
                .app.mobile-open .scrim { display: block; }
                .icon-btn.menu-toggle { display: flex; }
                #btn-collapse { display: none !important; }
                main { padding: 0.85rem; }

                /* Cibles tactiles plus confortables (≥44px de haut, recommandation Apple/Google). */
                .nav-item { padding: 0.7rem 0.6rem; font-size: 0.92rem; }
                .nav-item svg { width: 20px; height: 20px; }
                .sidebar-footer-bouton { padding: 0.6rem 0.6rem 0.6rem 0; }
            }

            @media (max-width: 768px) {
                h1 { font-size: 1.3rem; margin-bottom: 1rem; }
                h2 { font-size: 1.05rem; }

                table:not(.calendrier) { min-width: 560px; }

                form > div { margin-bottom: 0.85rem; }

                /* Empêche le zoom automatique iOS Safari sur les champs (déclenché en-dessous de 16px). */
                input[type="text"], input[type="email"], input[type="password"], input[type="tel"],
                input[type="number"], input[type="date"], input[type="time"], input[type="search"],
                input[type="url"],
                select, textarea {
                    font-size: 16px;
                    max-width: 100%;
                    padding: 0.65rem 0.75rem;
                }

                button, input[type="submit"] {
                    padding: 0.65rem 1rem;
                    font-size: 0.92rem;
                }

                td a, td form { display: block; margin: 0 0 0.4rem 0; }
                td a:last-child, td form:last-child { margin-bottom: 0; }
                a[href*="/modifier"], a[href*="supprimer"], form[action*="supprimer"] button {
                    text-align: center;
                    padding: 0.55rem 0.8rem;
                }

                .mouvement-form { flex-direction: column; align-items: stretch; }
                .mouvement-form input, .mouvement-form button { width: 100%; max-width: 100%; }

                /* Tableaux transformés en cartes empilées sur mobile (voir data-label sur chaque <td>). */
                table.table-cards { min-width: 0; box-shadow: none; background: transparent; border: none; }
                table.table-cards thead { display: none; }
                table.table-cards, table.table-cards tbody, table.table-cards tr, table.table-cards td { display: block; width: 100%; }
                table.table-cards tr {
                    background: var(--color-surface);
                    border: 1px solid var(--color-border);
                    border-radius: var(--radius);
                    box-shadow: var(--shadow);
                    margin-bottom: 0.75rem;
                    padding: 0.75rem 1rem;
                }
                table.table-cards td {
                    border-bottom: none;
                    padding: 0.3rem 0;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 0.75rem;
                    text-align: right;
                }
                table.table-cards td::before {
                    content: attr(data-label);
                    font-weight: 600;
                    font-size: 0.78rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    color: var(--color-text-muted);
                    text-align: left;
                }
                table.table-cards td:not([data-label])::before { content: none; }
                table.table-cards td.td-actions,
                table.table-cards td.td-mouvement {
                    flex-direction: column;
                    align-items: stretch;
                    text-align: left;
                    gap: 0.4rem;
                    margin-top: 0.4rem;
                }
                table.table-cards td.td-actions::before,
                table.table-cards td.td-mouvement::before { content: none; }
                table.table-cards td.td-actions a,
                table.table-cards td.td-actions form,
                table.table-cards td.td-mouvement form { width: 100%; margin: 0; }
                table.table-cards td.td-actions button { width: 100%; }
            }
        </style>
        {% endblock %}

