<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Axiobad{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        <link rel="apple-touch-icon" href="{{ asset('icons/apple-touch-icon.png') }}">
        <meta name="theme-color" content="#1b3a6b">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content="Axiobad">
        {% block stylesheets %}
        <style>
            :root {
                --color-bg: #f4f6fb;
                --color-surface: #ffffff;
                --color-border: #e4e8f1;
                --color-text: #1c2333;
                --color-text-muted: #6b7386;
                --color-primary: #1b3a6b;
                --color-primary-dark: #12274a;
                --color-accent: #f97316;
                --color-accent-dark: #ea580c;
                --color-success: #16a34a;
                --color-success-bg: #ecfdf3;
                --color-error: #dc2626;
                --color-error-bg: #fef2f2;
                --radius: 12px;
                --shadow: 0 1px 3px rgba(20, 30, 60, 0.08), 0 1px 2px rgba(20, 30, 60, 0.06);
            }

            * { box-sizing: border-box; }

            body {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                margin: 0;
                background: var(--color-bg);
                color: var(--color-text);
                line-height: 1.5;
            }

            h1, h2, h3 {
                font-weight: 700;
                letter-spacing: -0.01em;
                color: var(--color-primary-dark);
            }
            h1 { font-size: 1.75rem; margin: 0 0 1.25rem; }
            h2 { font-size: 1.25rem; margin: 2rem 0 0.75rem; }

            nav {
                background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
                padding: 0.75rem 1.5rem;
                display: flex;
                gap: 0.25rem;
                align-items: center;
                box-shadow: var(--shadow);
                position: sticky;
                top: 0;
                z-index: 10;
                flex-wrap: wrap;
            }
            nav .brand {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-right: 1rem;
                text-decoration: none;
            }
            nav .brand img { width: 28px; height: 28px; }
            nav .brand span {
                color: #fff;
                font-weight: 800;
                font-size: 1.15rem;
                letter-spacing: -0.02em;
            }
            nav a.nav-link {
                color: rgba(255,255,255,0.85);
                text-decoration: none;
                padding: 0.45rem 0.85rem;
                border-radius: 999px;
                font-size: 0.92rem;
                font-weight: 500;
                transition: background 0.15s ease, color 0.15s ease;
            }
            nav a.nav-link:hover { background: rgba(255,255,255,0.12); color: #fff; }
            nav .spacer { margin-left: auto; display: flex; align-items: center; gap: 0.75rem; }
            nav .user-link {
                color: #fff;
                text-decoration: none;
                font-weight: 600;
                font-size: 0.9rem;
                padding: 0.4rem 0.75rem;
                border-radius: 999px;
                background: rgba(255,255,255,0.1);
            }
            nav .user-link:hover { background: rgba(255,255,255,0.2); }
            nav .logout-link { color: rgba(255,255,255,0.7); text-decoration: none; font-size: 0.85rem; }
            nav .logout-link:hover { color: #fff; }

            .compte-menu { position: relative; }
            .compte-menu-bouton {
                display: flex;
                align-items: center;
                gap: 0.3rem;
                color: #fff;
                background: rgba(255,255,255,0.1);
                border: none;
                cursor: pointer;
                font-family: inherit;
                font-weight: 600;
                font-size: 0.9rem;
                padding: 0.4rem 0.75rem;
                border-radius: 999px;
            }
            .compte-menu-bouton:hover { background: rgba(255,255,255,0.2); }
            .compte-menu-bouton .chevron { font-size: 0.65rem; opacity: 0.8; }
            .compte-menu-liste {
                display: none;
                position: absolute;
                right: 0;
                top: calc(100% + 0.4rem);
                background: var(--color-surface);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                min-width: 200px;
                overflow: hidden;
                z-index: 20;
            }
            .compte-menu.ouvert .compte-menu-liste { display: block; }
            .compte-menu-liste a, .compte-menu-liste button {
                display: block;
                width: 100%;
                text-align: left;
                padding: 0.65rem 1rem;
                color: var(--color-text);
                text-decoration: none;
                background: none;
                border: none;
                font-family: inherit;
                font-size: 0.9rem;
                font-weight: 500;
                cursor: pointer;
                border-radius: 0;
            }
            .compte-menu-liste a:hover, .compte-menu-liste button:hover { background: var(--color-bg); }
            .compte-menu-liste .deconnexion { color: var(--color-error); }

            .nav-dropdown { position: relative; }
            .nav-dropdown-bouton {
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
                background: none;
                border: none;
                cursor: pointer;
                font-family: inherit;
            }
            .nav-dropdown-bouton .chevron { font-size: 0.6rem; opacity: 0.75; }
            .nav-dropdown-liste {
                display: none;
                position: absolute;
                left: 0;
                top: calc(100% + 0.4rem);
                background: var(--color-surface);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                min-width: 200px;
                overflow: hidden;
                z-index: 20;
            }
            .nav-dropdown.ouvert .nav-dropdown-liste { display: block; }
            .nav-dropdown-item {
                display: block;
                padding: 0.65rem 1rem;
                color: var(--color-text);
                text-decoration: none;
                font-size: 0.9rem;
                font-weight: 500;
            }
            .nav-dropdown-item:hover { background: var(--color-bg); }

            main { padding: 1.75rem; max-width: 1200px; margin: 0 auto; }

            .flash-success, .flash-error {
                padding: 0.75rem 1rem;
                border-radius: var(--radius);
                margin-bottom: 1rem;
                font-size: 0.92rem;
                font-weight: 500;
                border-left: 4px solid;
            }
            .flash-success { background: var(--color-success-bg); color: var(--color-success); border-color: var(--color-success); }
            .flash-error { background: var(--color-error-bg); color: var(--color-error); border-color: var(--color-error); }

            table {
                border-collapse: separate;
                border-spacing: 0;
                width: 100%;
                background: var(--color-surface);
                border-radius: var(--radius);
                overflow: hidden;
                box-shadow: var(--shadow);
                margin-bottom: 1.5rem;
            }
            th, td {
                padding: 0.7rem 1rem;
                text-align: left;
                border-bottom: 1px solid var(--color-border);
                font-size: 0.92rem;
            }
            th {
                background: #f8f9fc;
                color: var(--color-text-muted);
                font-weight: 600;
                font-size: 0.78rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }
            tbody tr:last-child td { border-bottom: none; }
            tbody tr:hover { background: #fafbfe; }

            form { margin-bottom: 0; }
            form > div { margin-bottom: 1rem; }
            label {
                display: block;
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--color-text-muted);
                margin-bottom: 0.3rem;
            }
            input[type="text"], input[type="email"], input[type="password"], input[type="tel"],
            input[type="number"], input[type="date"], input[type="time"], input[type="file"],
            select, textarea {
                width: 100%;
                max-width: 420px;
                padding: 0.55rem 0.75rem;
                border: 1px solid var(--color-border);
                border-radius: 8px;
                font-size: 0.92rem;
                font-family: inherit;
                background: var(--color-surface);
                color: var(--color-text);
            }
            input:focus, select:focus, textarea:focus {
                outline: none;
                border-color: var(--color-primary);
                box-shadow: 0 0 0 3px rgba(27, 58, 107, 0.12);
            }
            textarea { max-width: 100%; min-height: 5rem; }
            input[type="checkbox"] { width: auto; margin-right: 0.4rem; }

            button, input[type="submit"] {
                background: var(--color-primary);
                color: #fff;
                border: none;
                padding: 0.55rem 1.1rem;
                border-radius: 8px;
                font-size: 0.88rem;
                font-weight: 600;
                cursor: pointer;
                transition: background 0.15s ease, transform 0.05s ease;
            }
            button:hover, input[type="submit"]:hover { background: var(--color-primary-dark); }
            button:active { transform: scale(0.98); }

            .presence-form { display: flex; gap: 0.5rem; }
            .btn-presence {
                background: var(--color-surface);
                color: var(--color-text);
                border: 2px solid var(--color-border);
            }
            .btn-presence:hover { background: var(--color-bg); }
            .btn-presence.selectionne {
                border-color: transparent;
                cursor: default;
                box-shadow: inset 0 0 0 2px currentColor;
            }
            .btn-presence.selectionne:hover { background: inherit; }
            .btn-presence-oui.selectionne {
                background: var(--color-success-bg);
                color: var(--color-success);
            }
            .btn-presence-non.selectionne {
                background: var(--color-error-bg);
                color: var(--color-error);
            }

            a {
                color: var(--color-primary);
                font-weight: 500;
            }
            a[href*="supprimer"], form[action*="supprimer"] button {
                background: transparent;
                color: var(--color-error);
                border: 1px solid var(--color-error-bg);
            }
            form[action*="supprimer"] button:hover { background: var(--color-error-bg); }

            a[href*="/modifier"] {
                display: inline-block;
                background: var(--color-primary);
                color: #fff;
                padding: 0.4rem 0.8rem;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 600;
            }
            a[href*="/modifier"]:hover { background: var(--color-primary-dark); }

            .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

            .badge-inactif { background: var(--color-error-bg); color: var(--color-error); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.78rem; font-weight: 700; }
            .badge-actif { background: var(--color-success-bg); color: var(--color-success); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.78rem; font-weight: 700; }
            tr.ligne-inactive { opacity: 0.55; }

            .btn-cta {
                display: inline-block;
                background: var(--color-accent);
                color: #fff;
                padding: 0.5rem 1rem;
                border-radius: 8px;
                text-decoration: none;
                font-weight: 600;
                margin-bottom: 0.5rem;
            }
            .btn-cta:hover { background: var(--color-accent-dark); }

            .calendrier { box-shadow: var(--shadow); min-width: 800px; }
            .calendrier th { background: var(--color-primary); color: #fff; }
            .calendrier .hors-mois { background: #fafbfe !important; }
            .creneau-cal {
                background: #fff8f0;
                border: 1px solid #fde4c8 !important;
            }
            .creneau-cal.creneau-annule {
                background: #fafafa;
                border: 1px solid var(--color-border) !important;
                opacity: 0.75;
            }
            .agenda-creneau.creneau-annule { opacity: 0.7; }

            td a, td form { margin-right: 0.35rem; }
            td a:last-child { margin-right: 0; }

            @media (max-width: 768px) {
                nav { padding: 0.6rem 0.85rem; gap: 0.3rem; }
                nav .brand { margin-right: 0.4rem; }
                nav .brand span { font-size: 1rem; }
                nav a.nav-link {
                    padding: 0.45rem 0.7rem;
                    font-size: 0.82rem;
                    background: rgba(255,255,255,0.08);
                }
                nav .spacer { width: 100%; justify-content: space-between; margin-left: 0; order: 10; margin-top: 0.35rem; }

                main { padding: 0.85rem; }
                h1 { font-size: 1.3rem; margin-bottom: 1rem; }
                h2 { font-size: 1.05rem; }

                table:not(.calendrier) { min-width: 560px; }

                form > div { margin-bottom: 0.85rem; }

                /* Empêche le zoom automatique iOS Safari sur les champs (déclenché en-dessous de 16px). */
                input[type="text"], input[type="email"], input[type="password"], input[type="tel"],
                input[type="number"], input[type="date"], input[type="time"], input[type="search"],
                select, textarea {
                    font-size: 16px;
                    max-width: 100%;
                    padding: 0.65rem 0.75rem;
                }

                button, input[type="submit"] {
                    padding: 0.65rem 1rem;
                    font-size: 0.92rem;
                }

                td a, td form { display: block; margin: 0 0 0.4rem 0; }
                td a:last-child, td form:last-child { margin-bottom: 0; }
                a[href*="/modifier"], a[href*="supprimer"], form[action*="supprimer"] button {
                    text-align: center;
                    padding: 0.55rem 0.8rem;
                }

                .mouvement-form { flex-direction: column; align-items: stretch; }
                .mouvement-form input, .mouvement-form button { width: 100%; max-width: 100%; }

                /* Tableaux transformés en cartes empilées sur mobile (voir data-label sur chaque <td>). */
                table.table-cards { min-width: 0; box-shadow: none; background: transparent; }
                table.table-cards thead { display: none; }
                table.table-cards, table.table-cards tbody, table.table-cards tr, table.table-cards td { display: block; width: 100%; }
                table.table-cards tr {
                    background: var(--color-surface);
                    border-radius: var(--radius);
                    box-shadow: var(--shadow);
                    margin-bottom: 0.75rem;
                    padding: 0.75rem 1rem;
                }
                table.table-cards td {
                    border-bottom: none;
                    padding: 0.3rem 0;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 0.75rem;
                    text-align: right;
                }
                table.table-cards td::before {
                    content: attr(data-label);
                    font-weight: 600;
                    font-size: 0.78rem;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                    color: var(--color-text-muted);
                    text-align: left;
                }
                table.table-cards td:not([data-label])::before { content: none; }
                table.table-cards td.td-actions,
                table.table-cards td.td-mouvement {
                    flex-direction: column;
                    align-items: stretch;
                    text-align: left;
                    gap: 0.4rem;
                    margin-top: 0.4rem;
                }
                table.table-cards td.td-actions::before,
                table.table-cards td.td-mouvement::before { content: none; }
                table.table-cards td.td-actions a,
                table.table-cards td.td-actions form,
                table.table-cards td.td-mouvement form { width: 100%; margin: 0; }
                table.table-cards td.td-actions button { width: 100%; }
            }
        </style>
        {% endblock %}

    </head>
    <body>
        <nav>
            <a href="{{ path('app_home') }}" class="brand">
                <img src="{{ asset('logo.svg') }}" alt="Axiobad">
                <span>Axiobad</span>
            </a>
            {% if app.user %}
                <a class="nav-link" href="{{ path('app_mon_espace') }}">Mon espace</a>
                <a class="nav-link" href="{{ path('app_famille_index') }}">Ma famille</a>

                <div class="nav-dropdown">
                    <button type="button" class="nav-link nav-dropdown-bouton" onclick="toggleNavDropdown(this)">Jouer <span class="chevron">▼</span></button>
                    <div class="nav-dropdown-liste">
                        <a class="nav-dropdown-item" href="{{ path('app_calendrier') }}">Calendrier</a>
                        <a class="nav-dropdown-item" href="{{ path('app_creneau_index') }}">Créneaux</a>
                        <a class="nav-dropdown-item" href="{{ path('app_gymnase_index') }}">Gymnases</a>
                    </div>
                </div>

                <div class="nav-dropdown">
                    <button type="button" class="nav-link nav-dropdown-bouton" onclick="toggleNavDropdown(this)">Club <span class="chevron">▼</span></button>
                    <div class="nav-dropdown-liste">
                        <a class="nav-dropdown-item" href="{{ path('app_evenement_index') }}">Vie du club</a>
                        <a class="nav-dropdown-item" href="{{ path('app_equipe_index') }}">Équipes</a>
                        <a class="nav-dropdown-item" href="{{ path('app_interclub_index') }}">Interclubs</a>
                        <a class="nav-dropdown-item" href="{{ path('app_cordage_index') }}">Cordage</a>
                    </div>
                </div>

                {% if is_granted('ROLE_BUREAU') %}
                    <div class="nav-dropdown">
                        <button type="button" class="nav-link nav-dropdown-bouton" onclick="toggleNavDropdown(this)">Bureau <span class="chevron">▼</span></button>
                        <div class="nav-dropdown-liste">
                            <a class="nav-dropdown-item" href="{{ path('app_dashboard') }}">Tableau de bord</a>
                            <a class="nav-dropdown-item" href="{{ path('app_licencie_index') }}">Licenciés</a>
                            <a class="nav-dropdown-item" href="{{ path('app_licencie_index') }}">Adhésions et paiements</a>
                            <a class="nav-dropdown-item" href="{{ path('app_stock_index') }}">Stock</a>
                            <a class="nav-dropdown-item" href="{{ path('app_communication_index') }}">Communication</a>
                        </div>
                    </div>
                {% else %}
                    {% if is_granted('ROLE_ENTRAINEUR') %}
                        <a class="nav-link" href="{{ path('app_presence_index') }}">Présences</a>
                    {% endif %}
                    {% if is_granted('ROLE_STOCK') %}
                        <a class="nav-link" href="{{ path('app_stock_index') }}">Stock</a>
                    {% endif %}
                {% endif %}
            {% endif %}
            <span class="spacer">
                {% if app.user %}
                    <div class="compte-menu" id="compte-menu">
                        <button type="button" class="compte-menu-bouton" onclick="document.getElementById('compte-menu').classList.toggle('ouvert');">
                            {{ app.user.nomComplet }} <span class="chevron">▼</span>
                        </button>
                        <div class="compte-menu-liste">
                            <a href="{{ path('app_mon_profil') }}">Modifier mon profil</a>
                            <a href="{{ path('app_documentation') }}">Documentation</a>
                            <a href="{{ path('app_logout') }}" class="deconnexion">Déconnexion</a>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="user-link">Connexion</a>
                {% endif %}
            </span>
        </nav>
        <main>
            {% for message in app.flashes('success') %}
                <p class="flash-success">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p class="flash-error">{{ message }}</p>
            {% endfor %}
            {% block body %}{% endblock %}
        </main>

        <footer style="text-align: center; padding: 1.5rem 1rem; font-size: 0.85rem; color: var(--color-text-muted);">
            <a href="{{ path('app_confidentialite') }}">Politique de confidentialité</a>
            ·
            <a href="{{ path('app_mentions_legales') }}">Mentions légales</a>
        </footer>

        <script>
            function toggleNavDropdown(bouton) {
                var menu = bouton.closest('.nav-dropdown');
                var etaitOuvert = menu.classList.contains('ouvert');
                document.querySelectorAll('.nav-dropdown.ouvert').forEach(function (autre) {
                    autre.classList.remove('ouvert');
                });
                if (!etaitOuvert) {
                    menu.classList.add('ouvert');
                }
            }

            document.addEventListener('click', function (event) {
                var menu = document.getElementById('compte-menu');
                if (menu && menu.classList.contains('ouvert') && !menu.contains(event.target)) {
                    menu.classList.remove('ouvert');
                }
                document.querySelectorAll('.nav-dropdown.ouvert').forEach(function (dropdown) {
                    if (!dropdown.contains(event.target)) {
                        dropdown.classList.remove('ouvert');
                    }
                });
            });
        </script>

        {% block javascripts %}
        {% endblock %}

        <script>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('{{ asset('sw.js') }}').catch(function () {});
                });
            }
        </script>
    </body>
</html>
