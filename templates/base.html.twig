<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Axiobad{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block stylesheets %}
        <style>
            body { font-family: sans-serif; margin: 0; }
            nav { background: #1b3a5c; padding: 1rem; display: flex; gap: 1rem; align-items: center; }
            nav a { color: #fff; text-decoration: none; }
            main { padding: 1.5rem; }
            table { border-collapse: collapse; width: 100%; }
            th, td { border: 1px solid #ddd; padding: 0.5rem; text-align: left; }
            .flash-success { color: green; }
            .flash-error { color: red; }
        </style>
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        <nav>
            <a href="{{ path('app_creneau_index') }}">Créneaux</a>
            <a href="{{ path('app_calendrier') }}">Calendrier</a>
            <a href="{{ path('app_gymnase_index') }}">Gymnases</a>
            {% if is_granted('ROLE_BUREAU') %}
                <a href="{{ path('app_licencie_index') }}">Licenciés</a>
                <a href="{{ path('app_stock_index') }}">Stock</a>
            {% endif %}
            <span style="margin-left: auto">
                {% if app.user %}
                    <a href="{{ path('app_mon_profil') }}" style="color:#fff">{{ app.user.nomComplet }}</a> — <a href="{{ path('app_logout') }}" style="color:#fff">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" style="color:#fff">Connexion</a>
                {% endif %}
            </span>
        </nav>
        <main>
            {% for message in app.flashes('success') %}
                <p class="flash-success">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p class="flash-error">{{ message }}</p>
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
