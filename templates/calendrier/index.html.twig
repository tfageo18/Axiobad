{% extends 'base.html.twig' %}

{% block title %}Calendrier — Axiobad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .calendrier { width: 100%; border-collapse: collapse; table-layout: fixed; }
        .calendrier th { border: 1px solid #ddd; padding: 0.25rem; background: #f0f0f0; }
        .calendrier td { border: 1px solid #ddd; padding: 0.25rem; vertical-align: top; height: 1px; }
        .calendrier .hors-mois { background: #fafafa; color: #999; }
        .calendrier .jour-numero { font-weight: bold; }
        .creneau-cal { border: 1px solid #ccc; border-radius: 4px; padding: 0.25rem; margin-top: 0.25rem; font-size: 0.8rem; }
        .creneau-cal button { font-size: 0.75rem; padding: 0.1rem 0.3rem; }
        .rencontre-cal { border: 1px solid var(--color-accent); background: #fff7ed; border-radius: 4px; padding: 0.25rem; margin-top: 0.25rem; font-size: 0.8rem; }
        .rencontre-cal a { color: var(--color-accent-dark); font-weight: 700; text-decoration: none; }
        .agenda-rencontre { border: 1px solid var(--color-accent); background: #fff7ed; border-radius: 8px; padding: 0.65rem 0.75rem; margin-top: 0.6rem; }
        .agenda-rencontre a { font-size: 1rem; font-weight: 700; text-decoration: none; color: var(--color-accent-dark); }

        .agenda-mobile { display: none; }

        .nav-mois { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }

        @media (max-width: 768px) {
            .calendrier-desktop { display: none; }
            .agenda-mobile { display: block; }

            .nav-mois a { flex: 0 0 auto; font-size: 0.85rem; }
            .nav-mois strong { font-size: 1rem; text-align: center; }

            .agenda-jour {
                background: var(--color-surface);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                padding: 0.85rem 1rem;
                margin-bottom: 0.85rem;
            }
            .agenda-jour.hors-mois { opacity: 0.5; }
            .agenda-jour-titre {
                font-weight: 700;
                color: var(--color-primary-dark);
                margin-bottom: 0.5rem;
                text-transform: capitalize;
            }
            .agenda-creneau {
                border: 1px solid var(--color-border);
                border-radius: 8px;
                padding: 0.65rem 0.75rem;
                margin-top: 0.6rem;
            }
            .agenda-creneau a { font-size: 1rem; font-weight: 700; text-decoration: none; }
            .agenda-creneau .lieu { color: var(--color-text-muted); font-size: 0.85rem; margin: 0.15rem 0 0.5rem; }
            .agenda-creneau form { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; }
            .agenda-creneau form button { flex: 1; padding: 0.6rem; font-size: 0.9rem; }
            .agenda-creneau .ouv-ferm { font-size: 0.82rem; color: var(--color-text-muted); }
            .agenda-creneau details { margin-top: 0.5rem; }
            .agenda-creneau details summary { cursor: pointer; font-size: 0.85rem; color: var(--color-primary); font-weight: 600; }
            .agenda-creneau details form { flex-direction: column; margin-top: 0.5rem; }
            .agenda-creneau details label { width: 100%; }
            .agenda-vide { color: var(--color-text-muted); font-size: 0.9rem; }
        }
    </style>
{% endblock %}

{% block body %}
    <h1>Calendrier des créneaux</h1>

    <p>
        {% if vue == 'semaine' %}
            <a href="{{ path('app_calendrier', {vue: 'mois', mois: premierJourSemaine|date('Y-m'), tous: toutAfficher ? 1 : null}) }}">Vue mois</a> ·
            <strong>Vue semaine</strong>
        {% else %}
            <strong>Vue mois</strong> ·
            <a href="{{ path('app_calendrier', {vue: 'semaine', semaine: "now"|date('Y-m-d'), tous: toutAfficher ? 1 : null}) }}">Vue semaine</a>
        {% endif %}
    </p>

    <p class="nav-mois">
        {% if vue == 'semaine' %}
            <a href="{{ path('app_calendrier', {vue: 'semaine', semaine: semainePrecedente, tous: toutAfficher ? 1 : null}) }}">&laquo; Précédent</a>
            <strong>Semaine du {{ premierJourSemaine|date('d/m') }} au {{ dernierJourSemaine|date('d/m/Y') }}</strong>
            <a href="{{ path('app_calendrier', {vue: 'semaine', semaine: semaineSuivante, tous: toutAfficher ? 1 : null}) }}">Suivant &raquo;</a>
        {% else %}
            <a href="{{ path('app_calendrier', {mois: moisPrecedent, tous: toutAfficher ? 1 : null}) }}">&laquo; Précédent</a>
            <strong>{{ nomMois }}</strong>
            <a href="{{ path('app_calendrier', {mois: moisSuivant, tous: toutAfficher ? 1 : null}) }}">Suivant &raquo;</a>
        {% endif %}
    </p>

    {% set parametresVue = vue == 'semaine' ? {vue: 'semaine', semaine: premierJourSemaine|date('Y-m-d')} : {mois: premierDuMois|date('Y-m')} %}
    {% if not is_granted('ROLE_BUREAU') %}
        <p>
            {% if toutAfficher %}
                Affichage de tous les créneaux. <a href="{{ path('app_calendrier', parametresVue) }}">Voir seulement les créneaux adaptés à mon niveau et mon âge</a>
            {% else %}
                Affichage des créneaux adaptés à votre niveau et votre âge. <a href="{{ path('app_calendrier', parametresVue|merge({tous: 1})) }}">Voir tous les créneaux</a>
            {% endif %}
        </p>
    {% endif %}

    <div class="calendrier-desktop" style="overflow-x: auto;">
        <table class="calendrier">
            <thead>
                <tr>
                    <th>Lundi</th>
                    <th>Mardi</th>
                    <th>Mercredi</th>
                    <th>Jeudi</th>
                    <th>Vendredi</th>
                    <th>Samedi</th>
                    <th>Dimanche</th>
                </tr>
            </thead>
            <tbody>
                {% for semaine in semaines %}
                    <tr>
                        {% for jour in semaine %}
                            <td class="{{ jour.dansLeMois ? '' : 'hors-mois' }}">
                                <div class="jour-numero">{{ jour.date|date('d') }}</div>
                                {% for creneau in jour.creneaux %}
                                    {% set ouverture = jour.ouvertures[creneau.id] %}
                                    {% set exception = jour.exceptions[creneau.id] %}
                                    <div class="creneau-cal{{ exception and exception.estAnnulee ? ' creneau-annule' : '' }}">
                                        <a href="{{ path('app_creneau_detail', {id: creneau.id, date: jour.date|date('Y-m-d')}) }}">
                                            <strong>{{ creneau.nom }}</strong> {{ (exception ? exception.heureDebutEffective : creneau.heureDebut)|date('H:i') }}
                                        </a><br>
                                        <small>{{ creneau.activite }} · {{ exception ? exception.gymnaseEffectif.nom : creneau.gymnase.nom }} · {{ creneau.typeLabel }}{{ creneau.ouvertExternes ? ' · Ouvert extérieurs' : '' }}{{ creneau.ouvertAdos ? ' · Ados' : '' }}</small><br>

                                        {% if exception %}
                                            <p style="margin: 0.3rem 0; font-weight: 700; color: {{ exception.estAnnulee ? 'var(--color-error)' : 'var(--color-accent-dark)' }};">
                                                {{ exception.estAnnulee ? '✗ Séance annulée' : '⚠ Séance modifiée exceptionnellement' }}
                                            </p>
                                            {% if exception.note %}<small>{{ exception.note }}</small><br>{% endif %}
                                        {% endif %}

                                        {% set presence = jour.presences[creneau.id] %}
                                        {% if not (exception and exception.estAnnulee) %}
                                            <form method="post" action="{{ path('app_creneau_presence', {id: creneau.id}) }}" class="presence-form">
                                                <input type="hidden" name="date" value="{{ jour.date|date('Y-m-d') }}">
                                                <input type="hidden" name="retour" value="{{ app.request.requestUri }}">
                                                <button type="submit" name="present" value="1" class="btn-presence btn-presence-oui {{ presence and presence.present ? 'selectionne' : '' }}">✓ Je viens</button>
                                                <button type="submit" name="present" value="0" class="btn-presence btn-presence-non {{ presence and not presence.present ? 'selectionne' : '' }}">✗ Non</button>
                                            </form>
                                        {% endif %}

                                        {% if presence and presence.estEnListeAttente %}
                                            <small>⏳ Liste d'attente</small><br>
                                        {% elseif presence and presence.estEnAttenteConfirmation %}
                                            <small>⚠ Place à confirmer avant {{ presence.promotionExpiresAt|date('d/m H:i') }}</small>
                                            <form method="post" action="{{ path('app_creneau_confirmer_promotion', {id: creneau.id}) }}" style="display:inline">
                                                <input type="hidden" name="date" value="{{ jour.date|date('Y-m-d') }}">
                                                <input type="hidden" name="retour" value="{{ app.request.requestUri }}">
                                                <button type="submit">Confirmer</button>
                                            </form><br>
                                        {% endif %}

                                        {% if presence and presence.present %}
                                            <a href="{{ path('app_creneau_ics', {id: creneau.id, date: jour.date|date('Y-m-d')}) }}">📅 Mon agenda</a>
                                            · <a href="{{ path('app_creneau_google_agenda', {id: creneau.id, date: jour.date|date('Y-m-d')}) }}" target="_blank" rel="noopener">Google Agenda</a><br>
                                        {% endif %}

                                        <div>
                                            <small>
                                                Ouvre : {{ ouverture and ouverture.licencieOuverture ? ouverture.licencieOuverture.nomComplet : '—' }}<br>
                                                Ferme : {{ ouverture and ouverture.licencieFermeture ? ouverture.licencieFermeture.nomComplet : '—' }}
                                            </small>
                                        </div>

                                        {% if is_granted('ROLE_BUREAU') %}
                                            <details>
                                                <summary>Ouverture/fermeture</summary>
                                                <form method="post" action="{{ path('app_creneau_ouverture', {id: creneau.id}) }}">
                                                    <input type="hidden" name="date" value="{{ jour.date|date('Y-m-d') }}">
                                                    <input type="hidden" name="retour" value="{{ app.request.requestUri }}">
                                                    <label>Ouvre
                                                        <select name="licencieOuverture">
                                                            <option value="">—</option>
                                                            {% for l in licenciesDisponibles %}
                                                                <option value="{{ l.id }}" {{ ouverture and ouverture.licencieOuverture and ouverture.licencieOuverture.id == l.id ? 'selected' : '' }}>{{ l.nomComplet }}</option>
                                                            {% endfor %}
                                                        </select>
                                                    </label>
                                                    <label>Ferme
                                                        <select name="licencieFermeture">
                                                            <option value="">—</option>
                                                            {% for l in licenciesDisponibles %}
                                                                <option value="{{ l.id }}" {{ ouverture and ouverture.licencieFermeture and ouverture.licencieFermeture.id == l.id ? 'selected' : '' }}>{{ l.nomComplet }}</option>
                                                            {% endfor %}
                                                        </select>
                                                    </label>
                                                    <button type="submit">Valider</button>
                                                </form>
                                            </details>
                                            <a href="{{ path('app_creneau_exception_edit', {id: creneau.id, date: jour.date|date('Y-m-d')}) }}">{{ exception ? 'Modifier cette occurrence' : 'Annuler / modifier cette occurrence' }}</a>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                                {% for rencontre in jour.rencontres %}
                                    <div class="rencontre-cal">
                                        <a href="{{ path('app_interclub_detail', {id: rencontre.id}) }}">
                                            🏆 J{{ rencontre.journee }} {{ rencontre.equipe.nom }} vs {{ rencontre.adversaire }}
                                        </a><br>
                                        <small>{{ rencontre.dateRencontre|date('H:i') }} · {{ rencontre.lieu }}</small>
                                    </div>
                                {% endfor %}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="agenda-mobile">
        {% set aujourdhui = "now"|date('Y-m-d') %}
        {% for semaine in semaines %}
            {% for jour in semaine %}
                {% if jour.date|date('Y-m-d') >= aujourdhui %}
                <div class="agenda-jour {{ jour.dansLeMois ? '' : 'hors-mois' }}">
                    <div class="agenda-jour-titre">{{ jour.date|date('d/m') }} — {{ jour.date|date('N') == '1' ? 'Lundi' : jour.date|date('N') == '2' ? 'Mardi' : jour.date|date('N') == '3' ? 'Mercredi' : jour.date|date('N') == '4' ? 'Jeudi' : jour.date|date('N') == '5' ? 'Vendredi' : jour.date|date('N') == '6' ? 'Samedi' : 'Dimanche' }}</div>

                    {% if jour.creneaux is empty and jour.rencontres is empty %}
                        <p class="agenda-vide">Aucun créneau.</p>
                    {% endif %}

                    {% for rencontre in jour.rencontres %}
                        <div class="agenda-rencontre">
                            <a href="{{ path('app_interclub_detail', {id: rencontre.id}) }}">🏆 J{{ rencontre.journee }} — {{ rencontre.equipe.nom }} vs {{ rencontre.adversaire }}</a>
                            <div class="lieu">{{ rencontre.dateRencontre|date('H:i') }} · {{ rencontre.lieu }}</div>
                        </div>
                    {% endfor %}

                    {% for creneau in jour.creneaux %}
                        {% set ouverture = jour.ouvertures[creneau.id] %}
                        {% set exception = jour.exceptions[creneau.id] %}
                        {% set presence = jour.presences[creneau.id] %}
                        <div class="agenda-creneau{{ exception and exception.estAnnulee ? ' creneau-annule' : '' }}">
                            <a href="{{ path('app_creneau_detail', {id: creneau.id, date: jour.date|date('Y-m-d')}) }}">{{ creneau.nom }} — {{ (exception ? exception.heureDebutEffective : creneau.heureDebut)|date('H:i') }}</a>
                            <div class="lieu">{{ creneau.activite }} · {{ exception ? exception.gymnaseEffectif.nom : creneau.gymnase.nom }} · {{ creneau.typeLabel }}{{ creneau.ouvertExternes ? ' · Ouvert extérieurs' : '' }}{{ creneau.ouvertAdos ? ' · Ados' : '' }}</div>

                            {% if exception %}
                                <p style="margin: 0 0 0.5rem; font-weight: 700; color: {{ exception.estAnnulee ? 'var(--color-error)' : 'var(--color-accent-dark)' }};">
                                    {{ exception.estAnnulee ? '✗ Séance annulée' : '⚠ Séance modifiée exceptionnellement' }}
                                    {% if exception.note %} — {{ exception.note }}{% endif %}
                                </p>
                            {% endif %}

                            {% if not (exception and exception.estAnnulee) %}
                                <form method="post" action="{{ path('app_creneau_presence', {id: creneau.id}) }}" class="presence-form">
                                    <input type="hidden" name="date" value="{{ jour.date|date('Y-m-d') }}">
                                    <input type="hidden" name="retour" value="{{ app.request.requestUri }}">
                                    <button type="submit" name="present" value="1" class="btn-presence btn-presence-oui {{ presence and presence.present ? 'selectionne' : '' }}">✓ Je viens</button>
                                    <button type="submit" name="present" value="0" class="btn-presence btn-presence-non {{ presence and not presence.present ? 'selectionne' : '' }}">✗ Non</button>
                                </form>
                            {% endif %}

                            {% if presence and presence.estEnListeAttente %}
                                <p style="margin: 0 0 0.5rem;">⏳ Liste d'attente</p>
                            {% elseif presence and presence.estEnAttenteConfirmation %}
                                <p style="margin: 0 0 0.5rem;">⚠ Place à confirmer avant {{ presence.promotionExpiresAt|date('d/m H:i') }}</p>
                                <form method="post" action="{{ path('app_creneau_confirmer_promotion', {id: creneau.id}) }}" style="margin-bottom: 0.5rem;">
                                    <input type="hidden" name="date" value="{{ jour.date|date('Y-m-d') }}">
                                    <input type="hidden" name="retour" value="{{ app.request.requestUri }}">
                                    <button type="submit">Confirmer ma place</button>
                                </form>
                            {% endif %}

                            {% if presence and presence.present %}
                                <p style="margin: 0 0 0.5rem;">
                                    <a href="{{ path('app_creneau_ics', {id: creneau.id, date: jour.date|date('Y-m-d')}) }}">📅 Mon agenda</a>
                                    · <a href="{{ path('app_creneau_google_agenda', {id: creneau.id, date: jour.date|date('Y-m-d')}) }}" target="_blank" rel="noopener">Google Agenda</a>
                                </p>
                            {% endif %}

                            <div class="ouv-ferm">
                                Ouvre : {{ ouverture and ouverture.licencieOuverture ? ouverture.licencieOuverture.nomComplet : '—' }}<br>
                                Ferme : {{ ouverture and ouverture.licencieFermeture ? ouverture.licencieFermeture.nomComplet : '—' }}
                            </div>

                            {% if is_granted('ROLE_BUREAU') %}
                                <details>
                                    <summary>Ouverture/fermeture</summary>
                                    <form method="post" action="{{ path('app_creneau_ouverture', {id: creneau.id}) }}">
                                        <input type="hidden" name="date" value="{{ jour.date|date('Y-m-d') }}">
                                        <input type="hidden" name="retour" value="{{ app.request.requestUri }}">
                                        <label>Ouvre
                                            <select name="licencieOuverture">
                                                <option value="">—</option>
                                                {% for l in licenciesDisponibles %}
                                                    <option value="{{ l.id }}" {{ ouverture and ouverture.licencieOuverture and ouverture.licencieOuverture.id == l.id ? 'selected' : '' }}>{{ l.nomComplet }}</option>
                                                {% endfor %}
                                            </select>
                                        </label>
                                        <label>Ferme
                                            <select name="licencieFermeture">
                                                <option value="">—</option>
                                                {% for l in licenciesDisponibles %}
                                                    <option value="{{ l.id }}" {{ ouverture and ouverture.licencieFermeture and ouverture.licencieFermeture.id == l.id ? 'selected' : '' }}>{{ l.nomComplet }}</option>
                                                {% endfor %}
                                            </select>
                                        </label>
                                        <button type="submit">Valider</button>
                                    </form>
                                </details>
                                <p style="margin: 0.5rem 0 0;">
                                    <a href="{{ path('app_creneau_exception_edit', {id: creneau.id, date: jour.date|date('Y-m-d')}) }}">{{ exception ? 'Modifier cette occurrence' : 'Annuler / modifier cette occurrence' }}</a>
                                </p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                {% endif %}
            {% endfor %}
        {% endfor %}
    </div>
{% endblock %}
