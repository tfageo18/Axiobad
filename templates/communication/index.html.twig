{% extends 'base.html.twig' %}

{% block title %}Communication ciblée — Axiobad{% endblock %}

{% block body %}
    <h1>Communication ciblée</h1>
    <p>Envoie un email à un groupe de licenciés (ceux ayant un compte de connexion actif).</p>

    <form method="get" action="{{ path('app_communication_index') }}">
        <div>
            <label for="cible">Destinataires</label>
            <select name="cible" id="cible" onchange="this.form.submit()">
                <option value="">— Choisir —</option>
                <option value="TOUS" {{ cibleChoisie == 'TOUS' ? 'selected' : '' }}>Tous les licenciés</option>
                <option value="RESPONSABLES_LEGAUX" {{ cibleChoisie == 'RESPONSABLES_LEGAUX' ? 'selected' : '' }}>Responsables légaux</option>
                <option value="IMPAYES" {{ cibleChoisie == 'IMPAYES' ? 'selected' : '' }}>Adhésions impayées (saison en cours)</option>
                <option value="CATEGORIE:ADULTE" {{ cibleChoisie == 'CATEGORIE:ADULTE' ? 'selected' : '' }}>Adultes</option>
                <option value="CATEGORIE:ENFANT" {{ cibleChoisie == 'CATEGORIE:ENFANT' ? 'selected' : '' }}>Enfants</option>
                {% for equipe in equipes %}
                    <option value="EQUIPE:{{ equipe.id }}" {{ cibleChoisie == 'EQUIPE:' ~ equipe.id ? 'selected' : '' }}>Équipe — {{ equipe.nom }}</option>
                {% endfor %}
                {% for creneau in creneaux %}
                    <option value="CRENEAU:{{ creneau.id }}" {{ cibleChoisie == 'CRENEAU:' ~ creneau.id ? 'selected' : '' }}>Créneau — {{ creneau.nom }} ({{ creneau.jourSemaine }})</option>
                    <option value="NON_REPONDANTS:{{ creneau.id }}" {{ cibleChoisie == 'NON_REPONDANTS:' ~ creneau.id ? 'selected' : '' }}>Non-répondants — {{ creneau.nom }} ({{ creneau.jourSemaine }})</option>
                {% endfor %}
                {% for evenement in evenements %}
                    <option value="EVENEMENT:{{ evenement.id }}" {{ cibleChoisie == 'EVENEMENT:' ~ evenement.id ? 'selected' : '' }}>Participants — {{ evenement.titre }}</option>
                {% endfor %}
            </select>
        </div>
    </form>

    {% if destinataires is not null %}
        <div style="background: var(--color-surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
            <strong>{{ cibleLibelle }}</strong> — {{ destinataires|length }} destinataire(s)
            {% if destinataires|length %}
                <p style="color: var(--color-text-muted); font-size: 0.88rem;">{{ destinataires|map(l => l.nomComplet)|join(', ') }}</p>
            {% endif %}
        </div>

        {% if destinataires|length %}
            {% if modeles|length %}
                <div style="margin-bottom: 1rem;">
                    <label for="modele">Charger un modèle</label>
                    <select id="modele" onchange="chargerModele(this)">
                        <option value="">— Aucun —</option>
                        {% for modele in modeles %}
                            <option value="{{ modele.id }}" data-sujet="{{ modele.sujet|e('html_attr') }}" data-corps="{{ modele.corps|e('html_attr') }}">{{ modele.nom }}</option>
                        {% endfor %}
                    </select>
                    <details style="margin-top: 0.4rem;">
                        <summary style="cursor: pointer; font-size: 0.85rem; color: var(--color-primary);">Gérer les modèles</summary>
                        <ul style="margin: 0.5rem 0 0; padding: 0;">
                            {% for modele in modeles %}
                                <li style="list-style: none; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.3rem;">
                                    <span>{{ modele.nom }}</span>
                                    <form method="post" action="{{ path('app_communication_modele_supprimer', {id: modele.id}) }}" onsubmit="return confirm('Supprimer le modèle « ' ~ modele.nom ~ ' » ?');">
                                        <button type="submit" style="font-size: 0.8rem; padding: 0.15rem 0.4rem;">Supprimer</button>
                                    </form>
                                </li>
                            {% endfor %}
                        </ul>
                    </details>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_communication_envoyer') }}" enctype="multipart/form-data" onsubmit="return confirm('Envoyer ce message à ' ~ destinataires|length ~ ' destinataire(s) ?');">
                <input type="hidden" name="cible" value="{{ cibleChoisie }}">
                <div>
                    <label for="sujet">Sujet</label>
                    <input type="text" name="sujet" id="sujet" required style="max-width: 100%;">
                </div>
                <div>
                    <label for="corps">Message</label>
                    <textarea name="corps" id="corps" rows="8" required></textarea>
                </div>
                <div>
                    <label for="piece_jointe">Pièce jointe (optionnel)</label>
                    <input type="file" name="piece_jointe" id="piece_jointe">
                </div>
                <div>
                    <label>Envoi programmé (optionnel — laisser vide pour un envoi immédiat)</label>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <input type="date" name="date_envoi" aria-label="Date d'envoi">
                        <input type="time" name="heure_envoi" aria-label="Heure d'envoi">
                    </div>
                </div>
                <button type="submit">Envoyer à {{ destinataires|length }} destinataire(s)</button>
                <button type="button" onclick="enregistrerModele()">Enregistrer comme modèle</button>
            </form>
        {% endif %}
    {% endif %}

    <h2>Historique des envois</h2>
    <div class="table-scroll">
    <table class="table-cards">
        <thead>
            <tr>
                <th>Date</th>
                <th>Sujet</th>
                <th>Cible</th>
                <th>Statut</th>
                <th>Destinataires</th>
                <th>Échecs</th>
                <th>Pièce jointe</th>
                <th>Auteur</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for envoi in envois %}
                <tr>
                    <td data-label="Date">
                        {% if envoi.statut == 'EN_ATTENTE' %}
                            Programmé pour le {{ envoi.planifiePour|date('d/m/Y H:i') }}
                        {% else %}
                            {{ envoi.envoyeLe|date('d/m/Y H:i') }}
                        {% endif %}
                    </td>
                    <td data-label="Sujet">{{ envoi.sujet }}</td>
                    <td data-label="Cible">{{ envoi.cibleLibelle }}</td>
                    <td data-label="Statut">
                        {% if envoi.statut == 'EN_ATTENTE' %}
                            <span class="badge-inactif">En attente</span>
                        {% elseif envoi.statut == 'ANNULE' %}
                            <span style="color: var(--color-text-muted);">Annulé</span>
                        {% else %}
                            <span class="badge-actif">Envoyé</span>
                        {% endif %}
                    </td>
                    <td data-label="Destinataires">{{ envoi.nombreDestinataires }}</td>
                    <td data-label="Échecs">
                        {% if envoi.nombreEchecs %}
                            <span class="badge-inactif">{{ envoi.nombreEchecs }}</span>
                            <small title="{{ envoi.emailsEnEchec }}">({{ envoi.emailsEnEchec }})</small>
                        {% else %}
                            0
                        {% endif %}
                    </td>
                    <td data-label="Pièce jointe">{{ envoi.pieceJointeNom ?? '—' }}</td>
                    <td data-label="Auteur">{{ envoi.auteur ? envoi.auteur.nomComplet : '—' }}</td>
                    <td data-label="">
                        {% if envoi.statut == 'EN_ATTENTE' %}
                            <form method="post" action="{{ path('app_communication_annuler', {id: envoi.id}) }}" onsubmit="return confirm('Annuler cet envoi programmé ?');">
                                <button type="submit">Annuler</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="9">Aucun envoi pour l'instant.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function chargerModele(select) {
            const option = select.options[select.selectedIndex];
            if (!option.value) {
                return;
            }
            document.getElementById('sujet').value = option.dataset.sujet || '';
            document.getElementById('corps').value = option.dataset.corps || '';
        }

        function enregistrerModele() {
            const sujet = document.getElementById('sujet').value;
            const corps = document.getElementById('corps').value;
            if (!sujet || !corps) {
                alert('Renseignez le sujet et le message avant d\'enregistrer un modèle.');
                return;
            }
            const nom = prompt('Nom du modèle :');
            if (!nom) {
                return;
            }

            const form = document.createElement('form');
            form.method = 'post';
            form.action = '{{ path('app_communication_modele_creer') }}';
            for (const [key, value] of Object.entries({ nom, sujet, corps })) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = value;
                form.appendChild(input);
            }
            document.body.appendChild(form);
            form.submit();
        }
    </script>
{% endblock %}
