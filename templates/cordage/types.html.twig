{% extends 'base.html.twig' %}

{% block title %}Catalogue de cordages — Axiobad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        #recherche-types-cordage { max-width: 320px; margin-bottom: 1rem; }
        table.datatable th[data-sort] { cursor: pointer; user-select: none; }
        table.datatable th[data-sort]:hover { color: var(--color-primary); }
        table.datatable th[data-sort]::after { content: ' \2195'; opacity: 0.4; }
        table.datatable th[data-sort].tri-asc::after { content: ' \2191'; opacity: 1; }
        table.datatable th[data-sort].tri-desc::after { content: ' \2193'; opacity: 1; }
    </style>
{% endblock %}

{% block body %}
    <p><a href="{{ path('app_cordage_index') }}">&laquo; Retour au cordage</a></p>

    <h1>Catalogue de cordages</h1>

    <h2>Ajouter un cordage</h2>
    <form method="post" action="{{ path('app_cordage_type_new') }}">
        <div>
            <label for="nom">Nom</label>
            <input type="text" name="nom" id="nom" placeholder="ex: Yonex BG65" required>
        </div>
        <button type="submit">+ Ajouter</button>
    </form>

    <div>
        <label for="recherche-types-cordage">Rechercher</label>
        <input type="search" id="recherche-types-cordage" placeholder="Nom du cordage...">
    </div>

    <div class="table-scroll">
    <table class="datatable table-cards" id="table-types-cordage">
        <thead>
            <tr>
                <th data-sort="text">Nom</th>
                <th data-sort="text">Statut</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for type in types %}
                <tr class="{{ type.actif ? '' : 'ligne-inactive' }}">
                    <td data-label="Nom">{{ type.nom }}</td>
                    <td data-label="Statut">{{ (type.actif ? '<span class="badge-actif">Actif</span>' : '<span class="badge-inactif">Inactif</span>')|raw }}</td>
                    <td class="td-actions">
                        <form method="post" action="{{ path('app_cordage_type_toggle_actif', {id: type.id}) }}" style="display:inline">
                            <button type="submit">{{ type.actif ? 'Désactiver' : 'Réactiver' }}</button>
                        </form>
                        <form method="post" action="{{ path('app_cordage_type_delete', {id: type.id}) }}" onsubmit="return confirm('Supprimer ce cordage du catalogue ?');" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-type-cordage-' ~ type.id) }}">
                            <button type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3">Aucun cordage dans le catalogue.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var input = document.getElementById('recherche-types-cordage');
            var table = document.getElementById('table-types-cordage');
            if (!table) { return; }
            var tbody = table.querySelector('tbody');
            var lignesOriginal = Array.prototype.slice.call(tbody.querySelectorAll('tr'));

            input.addEventListener('input', function () {
                var terme = input.value.trim().toLowerCase();
                lignesOriginal.forEach(function (tr) {
                    var texte = tr.textContent.toLowerCase();
                    tr.style.display = texte.indexOf(terme) === -1 ? 'none' : '';
                });
            });

            table.querySelectorAll('th[data-sort]').forEach(function (th, index) {
                th.addEventListener('click', function () {
                    var asc = !th.classList.contains('tri-asc');
                    table.querySelectorAll('th[data-sort]').forEach(function (autre) {
                        autre.classList.remove('tri-asc', 'tri-desc');
                    });
                    th.classList.add(asc ? 'tri-asc' : 'tri-desc');

                    var lignes = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
                    lignes.sort(function (a, b) {
                        var va = (a.children[index] ? a.children[index].textContent : '').trim().toLowerCase();
                        var vb = (b.children[index] ? b.children[index].textContent : '').trim().toLowerCase();
                        if (va < vb) { return asc ? -1 : 1; }
                        if (va > vb) { return asc ? 1 : -1; }
                        return 0;
                    });
                    lignes.forEach(function (tr) { tbody.appendChild(tr); });
                });
            });
        })();
    </script>
{% endblock %}
