{% extends 'base.html.twig' %}

{% block title %}{{ creneau ? 'Modifier' : 'Nouveau' }} créneau — Axiobad{% endblock %}

{% block body %}
    <h1>{{ creneau ? 'Modifier le créneau' : 'Nouveau créneau' }}</h1>

    <form method="post" action="{{ creneau ? path('app_creneau_edit', {id: creneau.id}) : path('app_creneau_new') }}">
        <div>
            <label for="nom">Nom</label>
            <input type="text" name="nom" id="nom" value="{{ creneau ? creneau.nom : '' }}" required>
        </div>
        <div>
            <label for="gymnase">Gymnase</label>
            <select name="gymnase" id="gymnase" required>
                {% for gymnase in gymnases %}
                    <option value="{{ gymnase.id }}" {{ creneau and creneau.gymnase.id == gymnase.id ? 'selected' : '' }}>{{ gymnase.nom }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="jourSemaine">Jour</label>
            <select name="jourSemaine" id="jourSemaine" required>
                {% for jour in ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'] %}
                    <option value="{{ jour }}" {{ creneau and creneau.jourSemaine == jour ? 'selected' : '' }}>{{ jour }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="heureDebut">Heure de début</label>
            <input type="time" name="heureDebut" id="heureDebut" value="{{ creneau ? creneau.heureDebut|date('H:i') : '' }}" required>
        </div>
        <div>
            <label for="heureFin">Heure de fin</label>
            <input type="time" name="heureFin" id="heureFin" value="{{ creneau ? creneau.heureFin|date('H:i') : '' }}" required>
        </div>
        <div>
            <label for="recurrenceDebut">Le créneau se répète du</label>
            <input type="date" name="recurrenceDebut" id="recurrenceDebut" value="{{ creneau and creneau.recurrenceDebut ? creneau.recurrenceDebut|date('Y-m-d') : '' }}">
        </div>
        <div>
            <label for="recurrenceFin">au</label>
            <input type="date" name="recurrenceFin" id="recurrenceFin" value="{{ creneau and creneau.recurrenceFin ? creneau.recurrenceFin|date('Y-m-d') : '' }}">
            <small>Laisser vide si le créneau n'a pas de date de fin.</small>
        </div>
        <div>
            <label for="categorie">Catégorie</label>
            <select name="categorie" id="categorie" required>
                <option value="ADULTE" {{ (not creneau) or creneau.categorie == 'ADULTE' ? 'selected' : '' }}>Adultes</option>
                <option value="ENFANT" {{ creneau and creneau.categorie == 'ENFANT' ? 'selected' : '' }}>Enfants</option>
            </select>
        </div>
        <div>
            <label for="classementMinimum">Classement minimum requis</label>
            <input type="number" name="classementMinimum" id="classementMinimum" value="{{ creneau ? creneau.classementMinimum : '' }}">
            <small>Laisser vide si aucun niveau minimum n'est requis.</small>
        </div>
        <div>
            <label>
                <input type="checkbox" name="encadre" value="1" {{ creneau and creneau.encadre ? 'checked' : '' }} onchange="document.getElementById('entraineur-field').style.display = this.checked ? 'block' : 'none';">
                Créneau encadré
            </label>
        </div>
        <div id="entraineur-field" style="display: {{ creneau and creneau.encadre ? 'block' : 'none' }};">
            <label for="entraineur">Entraîneur</label>
            <select name="entraineur" id="entraineur">
                {% for entraineur in entraineurs %}
                    {% if 'ROLE_ENTRAINEUR' in entraineur.roles %}
                        <option value="{{ entraineur.id }}" {{ creneau and creneau.entraineur and creneau.entraineur.id == entraineur.id ? 'selected' : '' }}>{{ entraineur.nomComplet }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </div>
        <button type="submit">{{ creneau ? 'Enregistrer' : 'Créer' }}</button>
    </form>
{% endblock %}
