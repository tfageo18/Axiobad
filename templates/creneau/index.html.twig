{% extends 'base.html.twig' %}

{% block title %}Créneaux — Axiobad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        #recherche-creneaux { max-width: 320px; margin-bottom: 1rem; }
    </style>
{% endblock %}

{% block body %}
    <h1>Créneaux</h1>

    <p>Pour indiquer votre présence semaine par semaine, rendez-vous sur le <a href="{{ path('app_calendrier') }}">calendrier</a>.</p>

    {% if is_granted('ROLE_BUREAU') %}
        <p><a class="btn-cta" href="{{ path('app_creneau_new') }}">+ Nouveau créneau</a></p>
    {% else %}
        <p>
            {% if toutAfficher %}
                Affichage de tous les créneaux. <a href="{{ path('app_creneau_index') }}">Voir seulement les créneaux adaptés à mon niveau et mon âge</a>
            {% else %}
                Affichage des créneaux adaptés à votre niveau et votre âge. <a href="{{ path('app_creneau_index', {tous: 1}) }}">Voir tous les créneaux</a>
            {% endif %}
        </p>
    {% endif %}

    <div>
        <label for="recherche-creneaux">Rechercher</label>
        <input type="search" id="recherche-creneaux" placeholder="Nom, gymnase, jour...">
    </div>

    <div class="table-scroll">
    <table class="table-cards" id="table-creneaux">
        <thead>
            <tr>
                <th>Créneau</th>
                <th>Gymnase</th>
                <th>Jour</th>
                <th>Horaire</th>
                <th>Catégorie</th>
                <th>Niveau min.</th>
                <th>Encadrement</th>
                {% if is_granted('ROLE_BUREAU') %}<th>Statut</th><th></th>{% endif %}
            </tr>
        </thead>
        <tbody>
            {% for creneau in creneaux %}
                <tr class="{{ creneau.actif ? '' : 'ligne-inactive' }}">
                    <td data-label="Créneau">{{ creneau.nom }}</td>
                    <td data-label="Gymnase">{{ creneau.gymnase.nom }}</td>
                    <td data-label="Jour">{{ creneau.jourSemaine }}</td>
                    <td data-label="Horaire">{{ creneau.heureDebut|date('H:i') }} - {{ creneau.heureFin|date('H:i') }}</td>
                    <td data-label="Catégorie">{{ creneau.categorie == 'ENFANT' ? 'Enfants' : 'Adultes' }}</td>
                    <td data-label="Niveau min.">{{ creneau.classementMinimum ?? '-' }}</td>
                    <td data-label="Encadrement">
                        {% if creneau.encadre %}
                            Encadré par {{ creneau.entraineur.nomComplet }}
                        {% else %}
                            Libre
                        {% endif %}
                    </td>
                    {% if is_granted('ROLE_BUREAU') %}
                        <td data-label="Statut">{{ (creneau.actif ? '<span class="badge-actif">Actif</span>' : '<span class="badge-inactif">Inactif</span>')|raw }}</td>
                        <td class="td-actions">
                            <a href="{{ path('app_creneau_edit', {id: creneau.id}) }}">Modifier</a>
                            <form method="post" action="{{ path('app_creneau_toggle_actif', {id: creneau.id}) }}" style="display:inline">
                                <button type="submit">{{ creneau.actif ? 'Désactiver' : 'Réactiver' }}</button>
                            </form>
                            <form method="post" action="{{ path('app_creneau_delete', {id: creneau.id}) }}" onsubmit="return confirm('Supprimer ce créneau ?');" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-creneau-' ~ creneau.id) }}">
                                <button type="submit">Supprimer</button>
                            </form>
                        </td>
                    {% endif %}
                </tr>
            {% else %}
                <tr><td colspan="9">Aucun créneau.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var input = document.getElementById('recherche-creneaux');
            var table = document.getElementById('table-creneaux');
            if (!input || !table) { return; }
            var lignes = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));

            input.addEventListener('input', function () {
                var terme = input.value.trim().toLowerCase();
                lignes.forEach(function (tr) {
                    var texte = tr.textContent.toLowerCase();
                    tr.style.display = texte.indexOf(terme) === -1 ? 'none' : '';
                });
            });
        })();
    </script>
{% endblock %}
