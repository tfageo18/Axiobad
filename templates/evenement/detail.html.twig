{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }} — Axiobad{% endblock %}

{% block body %}
    <p><a href="{{ path('app_evenement_index') }}">&laquo; Retour à la vie du club</a></p>

    <h1>{{ evenement.titre }}</h1>
    <p style="color: var(--color-text-muted);">
        {{ evenement.typeLabel }} — {{ evenement.dateDebut|date('d/m/Y H:i') }}{{ evenement.dateFin ? ' → ' ~ evenement.dateFin|date('d/m/Y H:i') : '' }}
        {% if evenement.lieu %} — {{ evenement.lieu }}{% endif %}
    </p>

    {% if evenement.description %}
        <p>{{ evenement.description|nl2br }}</p>
    {% endif %}

    {% if is_granted('ROLE_BUREAU') %}
        <p><a href="{{ path('app_evenement_edit', {id: evenement.id}) }}">Modifier l'événement</a></p>
    {% endif %}

    <h2>Documents</h2>
    <p style="color: var(--color-text-muted); font-size: 0.9rem;">
        Convocation, ordre du jour, PV... — utile notamment pour les assemblées générales et réunions.
    </p>
    {% if evenement.documents|length %}
        <ul>
            {% for document in evenement.documents %}
                <li>
                    <a href="{{ path('app_evenement_document_telecharger', {id: evenement.id, documentId: document.id}) }}">{{ document.nomOriginal }}</a>
                    <small style="color: var(--color-text-muted);">
                        — ajouté le {{ document.ajouteLe|date('d/m/Y') }}{{ document.ajoutePar ? ' par ' ~ document.ajoutePar.nomComplet : '' }}
                    </small>
                    {% if is_granted('ROLE_BUREAU') %}
                        <form method="post" action="{{ path('app_evenement_document_delete', {id: evenement.id, documentId: document.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ce document ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('evenement-document-delete-' ~ document.id) }}">
                            <button type="submit">Supprimer</button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p><em>Aucun document pour l'instant.</em></p>
    {% endif %}
    {% if is_granted('ROLE_BUREAU') %}
        <form method="post" action="{{ path('app_evenement_document_new', {id: evenement.id}) }}" enctype="multipart/form-data" style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
            <input type="hidden" name="_token" value="{{ csrf_token('evenement-document-new-' ~ evenement.id) }}">
            <input type="file" name="document" required>
            <button type="submit">Ajouter un document</button>
        </form>
    {% endif %}

    <h2>Inscription</h2>
    {% if monInscription %}
        <p>
            {% if monInscription.statut == 'CONFIRMEE' %}
                Vous êtes <strong>inscrit(e)</strong> à cet événement.
            {% else %}
                Vous êtes en <strong>liste d'attente</strong>.
            {% endif %}
        </p>
        <form method="post" action="{{ path('app_evenement_desinscription', {id: evenement.id, inscriptionId: monInscription.id}) }}" onsubmit="return confirm('Vous désinscrire de cet événement ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('desinscription-' ~ monInscription.id) }}">
            <button type="submit">Me désinscrire</button>
        </form>
    {% else %}
        <form method="post" action="{{ path('app_evenement_inscription', {id: evenement.id}) }}">
            <button type="submit">{{ evenement.aDesPlacesDisponibles ? 'M\'inscrire' : 'M\'inscrire (liste d\'attente)' }}</button>
        </form>
    {% endif %}

    <h2>Participants ({{ evenement.participants|length }}{{ evenement.nombrePlaces ? ' / ' ~ evenement.nombrePlaces : '' }})</h2>
    {% if evenement.participants|length %}
        <table class="table-cards">
            <thead>
                <tr>
                    <th>Licencié</th>
                    <th>Inscrit(e) le</th>
                    {% if is_granted('ROLE_BUREAU') %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for inscription in evenement.participants %}
                    <tr>
                        <td data-label="Licencié">{{ inscription.licencie.nomComplet }}</td>
                        <td data-label="Inscrit le">{{ inscription.dateInscription|date('d/m/Y H:i') }}</td>
                        {% if is_granted('ROLE_BUREAU') %}
                            <td class="td-actions">
                                <form method="post" action="{{ path('app_evenement_desinscription', {id: evenement.id, inscriptionId: inscription.id}) }}" onsubmit="return confirm('Retirer ce participant ?');" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('desinscription-' ~ inscription.id) }}">
                                    <button type="submit">Retirer</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucun participant pour l'instant.</p>
    {% endif %}

    {% if evenement.listeAttente|length %}
        <h2>Liste d'attente ({{ evenement.listeAttente|length }})</h2>
        <table class="table-cards">
            <thead>
                <tr>
                    <th>Licencié</th>
                    <th>Inscrit(e) le</th>
                    {% if is_granted('ROLE_BUREAU') %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for inscription in evenement.listeAttente %}
                    <tr>
                        <td data-label="Licencié">{{ inscription.licencie.nomComplet }}</td>
                        <td data-label="Inscrit le">{{ inscription.dateInscription|date('d/m/Y H:i') }}</td>
                        {% if is_granted('ROLE_BUREAU') %}
                            <td class="td-actions">
                                <form method="post" action="{{ path('app_evenement_desinscription', {id: evenement.id, inscriptionId: inscription.id}) }}" onsubmit="return confirm('Retirer cette personne de la liste d\'attente ?');" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('desinscription-' ~ inscription.id) }}">
                                    <button type="submit">Retirer</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
