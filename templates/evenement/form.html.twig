{% extends 'base.html.twig' %}

{% block title %}{{ evenement ? 'Modifier' : 'Nouvel' }} événement — Axiobad{% endblock %}

{% block body %}
    <p><a href="{{ path('app_evenement_index') }}">&laquo; Retour à la vie du club</a></p>

    <h1>{{ evenement ? 'Modifier l\'événement' : 'Nouvel événement' }}</h1>

    <form method="post" action="{{ evenement ? path('app_evenement_edit', {id: evenement.id}) : path('app_evenement_new') }}">
        <div>
            <label for="type">Type</label>
            <select name="type" id="type" required>
                {% for valeur, libelle in types %}
                    <option value="{{ valeur }}" {{ evenement and evenement.type == valeur ? 'selected' : '' }}>{{ libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="titre">Titre</label>
            <input type="text" name="titre" id="titre" value="{{ evenement ? evenement.titre : '' }}" required>
        </div>
        <div>
            <label for="description">Description (optionnel)</label>
            <textarea name="description" id="description" rows="4">{{ evenement ? evenement.description : '' }}</textarea>
        </div>
        <div>
            <label for="lieu">Lieu (optionnel)</label>
            <input type="text" name="lieu" id="lieu" value="{{ evenement ? evenement.lieu : '' }}">
        </div>
        <div>
            <label for="dateDebut">Date et heure de début</label>
            <input type="datetime-local" name="dateDebut" id="dateDebut" value="{{ evenement and evenement.dateDebut ? evenement.dateDebut|date('Y-m-d\\TH:i') : '' }}" required>
        </div>
        <div>
            <label for="dateFin">Date et heure de fin (optionnel)</label>
            <input type="datetime-local" name="dateFin" id="dateFin" value="{{ evenement and evenement.dateFin ? evenement.dateFin|date('Y-m-d\\TH:i') : '' }}">
        </div>
        <div>
            <label for="nombrePlaces">Nombre de places (optionnel, vide = illimité)</label>
            <input type="number" name="nombrePlaces" id="nombrePlaces" min="1" value="{{ evenement ? evenement.nombrePlaces : '' }}">
        </div>
        <button type="submit">{{ evenement ? 'Enregistrer' : 'Créer' }}</button>
    </form>

    {% if evenement %}
        <form method="post" action="{{ path('app_evenement_delete', {id: evenement.id}) }}" onsubmit="return confirm('Supprimer cet événement ?');" style="margin-top: 1rem;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-evenement-' ~ evenement.id) }}">
            <button type="submit">Supprimer l'événement</button>
        </form>
    {% endif %}
{% endblock %}
