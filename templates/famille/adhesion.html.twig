{% extends 'base.html.twig' %}

{% block title %}Adhésion de {{ enfant.nomComplet }} — Axiobad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .statut-badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.85rem; font-weight: 700; }
        .statut-PAYEE { background: var(--color-success-bg); color: var(--color-success); }
        .statut-EN_ATTENTE { background: var(--color-error-bg); color: var(--color-error); }
        .statut-EXONEREE { background: #eef2ff; color: var(--color-primary-dark); }
        .recap-montants { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 1rem 0 1.5rem; }
        .recap-montants div { background: var(--color-surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 0.85rem 1.25rem; }
        .recap-montants strong { display: block; font-size: 1.3rem; color: var(--color-primary-dark); }
        .recap-montants small { color: var(--color-text-muted); }
    </style>
{% endblock %}

{% block body %}
    <p><a href="{{ path('app_famille_index') }}">&laquo; Retour à ma famille</a></p>

    <h1>Adhésion de {{ enfant.nomComplet }}</h1>

    <form method="get" style="margin-bottom: 1rem;">
        <label for="saison">Saison</label>
        <select name="saison" id="saison" onchange="this.form.submit()">
            {% for s in saisons %}
                <option value="{{ s.id }}" {{ saison.id == s.id ? 'selected' : '' }}>{{ s.libelle }}{{ s.estEnCours ? ' (en cours)' : '' }}</option>
            {% endfor %}
        </select>
    </form>

    <p>Statut actuel : <span class="statut-badge statut-{{ adhesion ? adhesion.statut : 'EN_ATTENTE' }}">{{ adhesion ? adhesion.statutLabel : 'En attente' }}</span></p>

    <div class="recap-montants">
        <div><small>Montant dû</small><strong>{{ adhesion and adhesion.montantTotal is not null ? adhesion.montantTotal|number_format(2, ',', ' ') ~ ' €' : '—' }}</strong></div>
        <div><small>Montant versé</small><strong>{{ adhesion ? adhesion.montantPaye|number_format(2, ',', ' ') : '0,00' }} €</strong></div>
        <div><small>Montant restant</small><strong>{{ adhesion and adhesion.montantRestant is not null ? adhesion.montantRestant|number_format(2, ',', ' ') ~ ' €' : '—' }}</strong></div>
    </div>

    <h2>Versements ({{ adhesion ? adhesion.paiements|length : 0 }})</h2>
    {% if adhesion and adhesion.paiements|length %}
        <div class="table-scroll">
        <table class="table-cards">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Montant</th>
                    <th>Moyen</th>
                    <th>N° chèque</th>
                </tr>
            </thead>
            <tbody>
                {% for paiement in adhesion.paiements %}
                    <tr>
                        <td data-label="Date">{{ paiement.date|date('d/m/Y') }}</td>
                        <td data-label="Montant">{{ paiement.montant|number_format(2, ',', ' ') }} €</td>
                        <td data-label="Moyen">{{ paiement.moyenLabel }}</td>
                        <td data-label="N° chèque">{{ paiement.numeroCheque ?? '-' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% else %}
        <p>Aucun versement enregistré.</p>
    {% endif %}

    <h2>Payer (paiement en plusieurs fois possible)</h2>
    <p style="color: var(--color-text-muted); font-size: 0.9rem;">
        Le bureau confirme le montant dû ; vous pouvez enregistrer ici vos versements pour {{ enfant.prenom }}.
    </p>
    <form method="post" action="{{ path('app_famille_adhesion_paiement_new', {id: enfant.id}) }}">
        <input type="hidden" name="saison" value="{{ saison.id }}">
        <div>
            <label for="montant">Montant (€)</label>
            <input type="number" step="0.01" min="0.01" name="montant" id="montant" required>
        </div>
        <div>
            <label for="date">Date</label>
            <input type="date" name="date" id="date" value="{{ 'now'|date('Y-m-d') }}" required>
        </div>
        <div>
            <label for="moyen">Moyen de paiement</label>
            <select name="moyen" id="moyen" onchange="document.getElementById('champ-numero-cheque').style.display = this.value === 'CHEQUE' ? 'block' : 'none';">
                {% for valeur, libelle in constant('App\\Entity\\PaiementAdhesion::MOYENS') %}
                    <option value="{{ valeur }}">{{ libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div id="champ-numero-cheque" style="display: none;">
            <label for="numeroCheque">Numéro de chèque</label>
            <input type="text" name="numeroCheque" id="numeroCheque">
        </div>
        <button type="submit">+ Ajouter le versement</button>
    </form>
{% endblock %}
