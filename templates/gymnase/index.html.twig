{% extends 'base.html.twig' %}

{% block title %}Gymnases — Axiobad{% endblock %}

{% block body %}
    <h1>Gymnases</h1>

    {% if is_granted('ROLE_BUREAU') %}
        <p><a class="btn-cta" href="{{ path('app_gymnase_new') }}">+ Nouveau gymnase</a></p>
    {% endif %}

    <div class="table-scroll">
    <table class="table-cards">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Adresse</th>
                <th>Téléphone</th>
                <th>Porteurs de clés</th>
                {% if is_granted('ROLE_BUREAU') %}<th></th>{% endif %}
            </tr>
        </thead>
        <tbody>
            {% for gymnase in gymnases %}
                <tr>
                    <td data-label="Nom">{{ gymnase.nom }}</td>
                    <td data-label="Adresse">{{ gymnase.adresse }}</td>
                    <td data-label="Téléphone">{{ gymnase.telephone ?? '-' }}</td>
                    <td data-label="Porteurs de clés">
                        {% if gymnase.porteursCles|length %}
                            {{ gymnase.porteursCles|map(l => l.nomComplet)|join(', ') }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    {% if is_granted('ROLE_BUREAU') %}
                        <td class="td-actions">
                            <a href="{{ path('app_gymnase_edit', {id: gymnase.id}) }}">Modifier</a>
                            <form method="post" action="{{ path('app_gymnase_delete', {id: gymnase.id}) }}" onsubmit="return confirm('Supprimer ce gymnase ?');" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-gymnase-' ~ gymnase.id) }}">
                                <button type="submit">Supprimer</button>
                            </form>
                        </td>
                    {% endif %}
                </tr>
            {% else %}
                <tr><td colspan="5">Aucun gymnase.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}
