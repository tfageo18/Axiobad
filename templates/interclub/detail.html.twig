{% extends 'base.html.twig' %}

{% block title %}J{{ rencontre.journee }} — {{ rencontre.adversaire }} — Axiobad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .badge-present { background: var(--color-success-bg); color: var(--color-success); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700; }
        .badge-absent { background: var(--color-error-bg); color: var(--color-error); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700; }
        .badge-attente { background: var(--color-bg); color: var(--color-text-muted); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700; }
    </style>
{% endblock %}

{% block body %}
    <p><a href="{{ path('app_interclub_index') }}">&laquo; Retour aux interclubs</a></p>

    <h1>Journée {{ rencontre.journee }} — {{ rencontre.equipe.nom }} vs {{ rencontre.adversaire }}</h1>
    <p style="color: var(--color-text-muted);">
        {{ rencontre.dateRencontre|date('d/m/Y H:i') }}{{ rencontre.heureRdv ? ' (RDV ' ~ rencontre.heureRdv|date('H:i') ~ ')' : '' }}
        — {{ rencontre.lieuAffiche }} — {{ rencontre.domicile ? 'Domicile' : 'Extérieur' }}
        {% if rencontre.equipe.championnat or rencontre.equipe.division %}
            — {{ [rencontre.equipe.championnat, rencontre.equipe.division]|filter(v => v)|join(' — ') }}
        {% endif %}
        {% if rencontre.aUnScore %} — Score : <strong>{{ rencontre.scoreEquipe }} - {{ rencontre.scoreAdversaire }}</strong>{% endif %}
    </p>
    <p>
        <strong>Capitaine de la rencontre</strong> :
        {{ rencontre.capitaineRencontre ? rencontre.capitaineRencontre.nomComplet : (rencontre.equipe.capitaine ? rencontre.equipe.capitaine.nomComplet ~ ' (capitaine d\'équipe)' : 'Non désigné') }}
    </p>
    {% if rencontre.covoiturage %}
        <p><strong>Covoiturage</strong> : {{ rencontre.covoiturage }}</p>
    {% endif %}

    {% if is_granted('ROLE_BUREAU') %}
        <p><a href="{{ path('app_interclub_edit', {id: rencontre.id}) }}">Modifier la rencontre</a></p>
    {% endif %}

    <h2>Composition (joueurs présents)</h2>
    {% set presents = rencontre.convocations|filter(c => c.present) %}
    {% if presents|length %}
        <p>{{ presents|map(c => c.licencie.nomComplet)|join(', ') }}</p>
    {% else %}
        <p>Aucun joueur confirmé présent pour l'instant.</p>
    {% endif %}

    {% if maConvocation %}
        <h2>Ma présence</h2>
        <p>
            Vous êtes convoqué(e) pour cette rencontre.
            {% if maConvocation.present is null %}
                <span class="badge-attente">Pas encore répondu</span>
            {% elseif maConvocation.present %}
                <span class="badge-present">Présent</span>
            {% else %}
                <span class="badge-absent">Absent</span>
            {% endif %}
        </p>
        <form method="post" action="{{ path('app_interclub_repondre', {id: rencontre.id, convocationId: maConvocation.id}) }}" style="display:inline">
            <button type="submit" name="present" value="1" class="btn-presence btn-presence-oui {{ maConvocation.present ? 'selectionne' : '' }}">✓ Je viens</button>
        </form>
        <form method="post" action="{{ path('app_interclub_repondre', {id: rencontre.id, convocationId: maConvocation.id}) }}" style="display:inline">
            <button type="submit" name="present" value="0" class="btn-presence btn-presence-non {{ maConvocation.present is same as(false) ? 'selectionne' : '' }}">✗ Je ne viens pas</button>
        </form>
    {% endif %}

    <h2>Convocations ({{ rencontre.convocations|length }})</h2>
    {% if rencontre.convocations|length %}
        <table class="table-cards">
            <thead>
                <tr>
                    <th>Joueur</th>
                    <th>Réponse</th>
                    {% if is_granted('ROLE_BUREAU') %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for convocation in rencontre.convocations %}
                    <tr>
                        <td data-label="Joueur">{{ convocation.licencie.nomComplet }}</td>
                        <td data-label="Réponse">
                            {% if convocation.present is null %}
                                <span class="badge-attente">Pas encore répondu</span>
                            {% elseif convocation.present %}
                                <span class="badge-present">Présent</span>
                            {% else %}
                                <span class="badge-absent">Absent</span>
                            {% endif %}
                        </td>
                        {% if is_granted('ROLE_BUREAU') %}
                            <td class="td-actions">
                                <form method="post" action="{{ path('app_interclub_retirer_convocation', {id: rencontre.id, convocationId: convocation.id}) }}" onsubmit="return confirm('Retirer cette convocation ?');" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('retirer-convocation-' ~ convocation.id) }}">
                                    <button type="submit">Retirer</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucun joueur convoqué pour l'instant.</p>
    {% endif %}

    {% if is_granted('ROLE_BUREAU') and membresConvocables|length %}
        <form method="post" action="{{ path('app_interclub_convoquer', {id: rencontre.id}) }}">
            <div>
                <label for="convoquer-licencie">Convoquer un joueur de l'équipe</label>
                <select name="licencie" id="convoquer-licencie" required>
                    <option value="">-</option>
                    {% for licencie in membresConvocables %}
                        <option value="{{ licencie.id }}">{{ licencie.nomComplet }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit">+ Convoquer</button>
        </form>
    {% endif %}

    <h2>Feuille de rencontre ({{ rencontre.matchs|length }} match(s))</h2>
    {% if rencontre.matchs|length %}
        <div class="table-scroll">
        <table class="table-cards">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Nos joueurs</th>
                    <th>Adversaires</th>
                    <th>Score</th>
                    <th>Résultat</th>
                    {% if is_granted('ROLE_BUREAU') %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for match in rencontre.matchs %}
                    <tr>
                        <td data-label="Type">{{ match.typeLabel }}</td>
                        <td data-label="Nos joueurs">{{ match.joueurs|map(j => j.nomComplet)|join(' / ') ?: '-' }}</td>
                        <td data-label="Adversaires">{{ match.adversaires ?? '-' }}</td>
                        <td data-label="Score">{{ match.score ?? '-' }}</td>
                        <td data-label="Résultat">
                            {% if match.gagne is null %}
                                <span class="badge-attente">-</span>
                            {% elseif match.gagne %}
                                <span class="badge-present">Gagné</span>
                            {% else %}
                                <span class="badge-absent">Perdu</span>
                            {% endif %}
                        </td>
                        {% if is_granted('ROLE_BUREAU') %}
                            <td class="td-actions">
                                <form method="post" action="{{ path('app_interclub_match_delete', {id: rencontre.id, matchId: match.id}) }}" onsubmit="return confirm('Supprimer ce match ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-match-' ~ match.id) }}">
                                    <button type="submit">Supprimer</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% else %}
        <p>Aucun match enregistré pour l'instant.</p>
    {% endif %}

    {% if is_granted('ROLE_BUREAU') %}
        <h3>Ajouter un match</h3>
        <form method="post" action="{{ path('app_interclub_match_new', {id: rencontre.id}) }}">
            <div>
                <label for="type">Type de match</label>
                <select name="type" id="type" required>
                    {% for code, libelle in constant('App\\Entity\\MatchInterclub::TYPES_LABELS') %}
                        <option value="{{ code }}">{{ libelle }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="joueur1">Notre joueur 1</label>
                <select name="joueur1" id="joueur1">
                    <option value="">-</option>
                    {% for licencie in membresEquipe %}
                        <option value="{{ licencie.id }}">{{ licencie.nomComplet }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="joueur2">Notre joueur 2 (double uniquement)</label>
                <select name="joueur2" id="joueur2">
                    <option value="">-</option>
                    {% for licencie in membresEquipe %}
                        <option value="{{ licencie.id }}">{{ licencie.nomComplet }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="adversaires">Adversaire(s) (optionnel, texte libre)</label>
                <input type="text" name="adversaires" id="adversaires" placeholder="ex: Dupont / Martin">
            </div>
            <div>
                <label for="score">Score (optionnel)</label>
                <input type="text" name="score" id="score" placeholder="ex: 21-15, 18-21, 21-19">
            </div>
            <div>
                <label for="gagne">Résultat</label>
                <select name="gagne" id="gagne">
                    <option value="">Pas encore joué</option>
                    <option value="1">Gagné</option>
                    <option value="0">Perdu</option>
                </select>
            </div>
            <button type="submit">+ Ajouter le match</button>
        </form>
    {% endif %}
{% endblock %}
