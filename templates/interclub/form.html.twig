{% extends 'base.html.twig' %}

{% block title %}{{ rencontre ? 'Modifier' : 'Nouvelle' }} rencontre — Axiobad{% endblock %}

{% block body %}
    <p><a href="{{ path('app_interclub_index') }}">&laquo; Retour aux interclubs</a></p>

    <h1>{{ rencontre ? 'Modifier la rencontre' : 'Nouvelle rencontre' }}</h1>

    <form method="post" action="{{ rencontre ? path('app_interclub_edit', {id: rencontre.id}) : path('app_interclub_new') }}">
        <input type="hidden" name="_token" value="{{ csrf_token(rencontre ? 'interclub-edit-' ~ rencontre.id : 'interclub-new') }}">
        <div>
            <label for="equipe">Équipe</label>
            <select name="equipe" id="equipe" required>
                <option value="">-</option>
                {% for equipe in equipes %}
                    <option value="{{ equipe.id }}" {{ rencontre and rencontre.equipe and rencontre.equipe.id == equipe.id ? 'selected' : '' }}>{{ equipe.nom }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="journee">Journée</label>
            <input type="number" name="journee" id="journee" min="1" value="{{ rencontre ? rencontre.journee : '' }}" required>
        </div>
        <div>
            <label for="dateRencontre">Date et heure</label>
            <input type="datetime-local" name="dateRencontre" id="dateRencontre" value="{{ rencontre and rencontre.dateRencontre ? rencontre.dateRencontre|date('Y-m-d\\TH:i') : '' }}" required>
        </div>
        <div>
            <label for="adversaire">Adversaire</label>
            <input type="text" name="adversaire" id="adversaire" value="{{ rencontre ? rencontre.adversaire : '' }}" required>
        </div>
        <div>
            <label>
                <input type="checkbox" name="domicile" id="domicile" value="1" {{ not rencontre or rencontre.domicile ? 'checked' : '' }} onchange="document.getElementById('champ-gymnase').style.display = this.checked ? 'block' : 'none'; document.getElementById('champ-lieu').style.display = this.checked ? 'none' : 'block';">
                À domicile (décocher si à l'extérieur)
            </label>
        </div>
        <div id="champ-gymnase" style="display: {{ not rencontre or rencontre.domicile ? 'block' : 'none' }};">
            <label for="gymnase">Gymnase</label>
            <select name="gymnase" id="gymnase">
                <option value="">-</option>
                {% for gymnase in gymnases %}
                    <option value="{{ gymnase.id }}" {{ rencontre and rencontre.gymnase and rencontre.gymnase.id == gymnase.id ? 'selected' : '' }}>{{ gymnase.nom }}</option>
                {% endfor %}
            </select>
        </div>
        <div id="champ-lieu" style="display: {{ not rencontre or rencontre.domicile ? 'none' : 'block' }};">
            <label for="lieu">Lieu</label>
            <input type="text" name="lieu" id="lieu" value="{{ rencontre and not rencontre.domicile ? rencontre.lieu : '' }}" placeholder="ex: Gymnase de la ville adverse">
        </div>
        <div>
            <label for="heureRdv">Heure de rendez-vous (optionnel)</label>
            <input type="time" name="heureRdv" id="heureRdv" value="{{ rencontre and rencontre.heureRdv ? rencontre.heureRdv|date('H:i') : '' }}">
        </div>
        <div>
            <label for="capitaineRencontre">Capitaine de la rencontre (optionnel — sinon celui de l'équipe)</label>
            <select name="capitaineRencontre" id="capitaineRencontre">
                <option value="">-</option>
                {% for licencie in licencies %}
                    <option value="{{ licencie.id }}" {{ rencontre and rencontre.capitaineRencontre and rencontre.capitaineRencontre.id == licencie.id ? 'selected' : '' }}>{{ licencie.nomComplet }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="covoiturage">Covoiturage (optionnel)</label>
            <textarea name="covoiturage" id="covoiturage" rows="3" placeholder="ex: Départ 13h30 parking du club, 2 places dispo chez Marc...">{{ rencontre ? rencontre.covoiturage : '' }}</textarea>
        </div>
        <div>
            <label for="scoreEquipe">Score de l'équipe (optionnel)</label>
            <input type="number" name="scoreEquipe" id="scoreEquipe" min="0" value="{{ rencontre ? rencontre.scoreEquipe : '' }}">
        </div>
        <div>
            <label for="scoreAdversaire">Score de l'adversaire (optionnel)</label>
            <input type="number" name="scoreAdversaire" id="scoreAdversaire" min="0" value="{{ rencontre ? rencontre.scoreAdversaire : '' }}">
        </div>
        <button type="submit">{{ rencontre ? 'Enregistrer' : 'Créer' }}</button>
    </form>

    {% if rencontre %}
        <form method="post" action="{{ path('app_interclub_delete', {id: rencontre.id}) }}" onsubmit="return confirm('Supprimer cette rencontre ?');" style="margin-top: 1rem;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-rencontre-' ~ rencontre.id) }}">
            <button type="submit">Supprimer la rencontre</button>
        </form>
    {% endif %}
{% endblock %}
