{% extends 'base.html.twig' %}

{% block title %}Journal d'audit — Axiobad{% endblock %}

{% block body %}
    <h1>Journal d'audit</h1>
    <p>
        Trace les actions sensibles : paiements, informations de santé, responsables légaux,
        suppression de compte, rôles, corrections de stock, annulations de créneau, adhésions.
    </p>

    <form method="get" action="{{ path('app_journal_audit_index') }}" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
        <div>
            <label for="action">Type d'action</label>
            <select name="action" id="action" onchange="this.form.submit()">
                <option value="">Toutes</option>
                {% for code in actionsDisponibles %}
                    <option value="{{ code }}" {{ actionChoisie == code ? 'selected' : '' }}>{{ libellesActions[code] ?? code }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="utilisateur">Auteur</label>
            <select name="utilisateur" id="utilisateur" onchange="this.form.submit()">
                <option value="">Tous</option>
                {% for licencie in licencies %}
                    <option value="{{ licencie.id }}" {{ utilisateurChoisi == licencie.id ? 'selected' : '' }}>{{ licencie.nomComplet }}</option>
                {% endfor %}
            </select>
        </div>
    </form>

    <div class="table-scroll">
    <table class="table-cards">
        <thead>
            <tr>
                <th>Date</th>
                <th>Action</th>
                <th>Objet</th>
                <th>Ancienne valeur</th>
                <th>Nouvelle valeur</th>
                <th>Auteur</th>
            </tr>
        </thead>
        <tbody>
            {% for entree in entrees %}
                <tr>
                    <td data-label="Date">{{ entree.horodatage|date('d/m/Y H:i') }}</td>
                    <td data-label="Action">{{ libellesActions[entree.action] ?? entree.action }}</td>
                    <td data-label="Objet">{{ entree.objetLibelle ?? '-' }}</td>
                    <td data-label="Ancienne valeur">{{ entree.ancienneValeur ?? '-' }}</td>
                    <td data-label="Nouvelle valeur">{{ entree.nouvelleValeur ?? '-' }}</td>
                    <td data-label="Auteur">{{ entree.utilisateurLibelle ?? 'Système' }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6">Aucune entrée pour l'instant.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
    <p style="color: var(--color-text-muted); font-size: 0.85rem;">Affiche les 200 dernières entrées.</p>
{% endblock %}
