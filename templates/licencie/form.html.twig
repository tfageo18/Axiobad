{% extends 'base.html.twig' %}

{% block title %}{{ licencie ? 'Modifier' : 'Nouveau' }} licencié — Axiobad{% endblock %}

{% block body %}
    <h1>{{ licencie ? 'Modifier le licencié' : 'Nouveau licencié' }}</h1>
    {% if not licencie %}
        <p>
            Si un email est renseigné, un lien d'activation lui sera envoyé pour définir son mot de
            passe. Laissez l'email vide pour un <strong>mineur sans compte propre</strong> (rattaché
            à un ou deux responsables légaux ci-dessous) — ça évite de créer une adresse email
            artificielle pour un enfant.
        </p>
    {% endif %}

    <form method="post" action="{{ licencie ? path('app_licencie_edit', {id: licencie.id}) : path('app_licencie_new') }}">
        <input type="hidden" name="_token" value="{{ csrf_token(licencie ? 'licencie-edit-' ~ licencie.id : 'licencie-new') }}">
        <div>
            <label for="prenom">Prénom</label>
            <input type="text" name="prenom" id="prenom" value="{{ licencie ? licencie.prenom : '' }}" required>
        </div>
        <div>
            <label for="nom">Nom</label>
            <input type="text" name="nom" id="nom" value="{{ licencie ? licencie.nom : '' }}" required>
        </div>
        <div>
            <label for="email">Email {{ licencie ? '' : '(optionnel — vide = mineur sans compte)' }}</label>
            <input type="email" name="email" id="email" value="{{ licencie ? licencie.email : '' }}">
        </div>
        <div>
            <label>
                <input type="checkbox" name="roles[]" value="ROLE_BUREAU" {{ licencie and licencie.isMembreBureau ? 'checked' : '' }}>
                Membre du bureau (administrateur)
            </label>
        </div>
        <div>
            <label>
                <input type="checkbox" name="roles[]" value="ROLE_ENTRAINEUR" {{ licencie and licencie.isEntraineur ? 'checked' : '' }}>
                Entraîneur
            </label>
        </div>
        <div>
            <label>
                <input type="checkbox" name="roles[]" value="ROLE_CORDEUR" {{ licencie and licencie.isCordeur ? 'checked' : '' }}>
                Cordeur
            </label>
        </div>
        <div>
            <label>
                <input type="checkbox" name="roles[]" value="ROLE_STOCK" {{ licencie and licencie.isStock ? 'checked' : '' }}>
                Accès au stock
            </label>
        </div>
        <div>
            <label>
                <input type="checkbox" name="notificationsActivees" value="1" {{ licencie and licencie.notificationsActivees ? 'checked' : '' }}>
                Notifications automatiques par email activées
            </label>
            <small style="color: var(--color-text-muted);">
                Désactivées par défaut. Le licencié peut aussi changer ce réglage lui-même depuis
                son profil.
            </small>
        </div>
        <div>
            <label for="dateNaissance">Date de naissance</label>
            <input type="date" name="dateNaissance" id="dateNaissance" value="{{ licencie and licencie.dateNaissance ? licencie.dateNaissance|date('Y-m-d') : '' }}">
        </div>
        {% if licencie %}
            <div>
                <label for="numeroLicence">Numéro de licence FFBaD</label>
                <input type="text" name="numeroLicence" id="numeroLicence" value="{{ licencie.numeroLicence }}">
            </div>
            <div>
                <label>
                    <input type="checkbox" name="doubleLicence" id="doubleLicence" value="1" {{ licencie.doubleLicence ? 'checked' : '' }} onchange="document.getElementById('club-double-licence-field').style.display = this.checked ? 'block' : 'none';">
                    Double licence (licencié également dans un autre club)
                </label>
            </div>
            <div id="club-double-licence-field" style="display: {{ licencie.doubleLicence ? 'block' : 'none' }};">
                <label for="clubDoubleLicence">Club de la double licence (optionnel)</label>
                <input type="text" name="clubDoubleLicence" id="clubDoubleLicence" value="{{ licencie.clubDoubleLicence }}">
            </div>
            {% if parametresClub.urlEffectifMyFfbad %}
                <div style="background: var(--color-surface-2); border-radius: var(--radius); padding: 0.75rem 1rem; margin-bottom: 1rem;">
                    {% if licencie.myFfbadDerniereSyncLe %}
                        {% if licencie.myFfbadSyncReussie %}
                            <span style="color: var(--color-success);">✓ Synchronisé avec MyFFBaD</span>
                        {% else %}
                            <span style="color: var(--color-error);">✗ Aucune correspondance trouvée sur MyFFBaD</span>
                        {% endif %}
                        — dernière tentative le {{ licencie.myFfbadDerniereSyncLe|date('d/m/Y à H:i') }}
                    {% else %}
                        <span style="color: var(--color-text-muted);">Jamais synchronisé avec MyFFBaD</span>
                    {% endif %}
                    <button type="submit" form="form-synchroniser-myffbad" style="margin-left: 0.75rem;">Synchroniser MyFFBaD</button>
                    {% if licencie.myFfbadCategorieAge %}
                        <div style="margin-top: 0.4rem; color: var(--color-text-muted); font-size: 0.88rem;">
                            Catégorie FFBaD : {{ licencie.myFfbadCategorieAge }}
                            {% if licencie.myFfbadEstMineur %}<span style="color: var(--color-warning);">(mineur selon MyFFBaD)</span>{% endif %}
                            — indicatif, la date de naissance ci-dessus fait foi.
                        </div>
                    {% endif %}
                </div>
            {% endif %}
            <div>
                <label for="genre">Genre (optionnel)</label>
                <select name="genre" id="genre">
                    <option value="">-</option>
                    {% for valeur, libelle in constant('App\\Entity\\Licencie::GENRES') %}
                        <option value="{{ valeur }}" {{ licencie.genre == valeur ? 'selected' : '' }}>{{ libelle }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="categorieAge">Catégorie d'âge (optionnel)</label>
                <select name="categorieAge" id="categorieAge">
                    <option value="">-</option>
                    {% for code, libelle in constant('App\\Badminton\\CategorieAge::CODES') %}
                        <option value="{{ code }}" {{ licencie.categorieAge == code ? 'selected' : '' }}>{{ libelle }}</option>
                    {% endfor %}
                </select>
                <small style="color: var(--color-text-muted);">
                    Mise à jour automatiquement par la synchronisation MyFFBaD, modifiable manuellement.
                </small>
            </div>
            <div>
                <label for="classementSimple">Classement simple</label>
                <select name="classementSimple" id="classementSimple">
                    <option value="">-</option>
                    {% for code in constant('App\\Badminton\\ClassementFfbad::CODES')|reverse %}
                        <option value="{{ code }}" {{ licencie.classementSimple == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="classementDouble">Classement double</label>
                <select name="classementDouble" id="classementDouble">
                    <option value="">-</option>
                    {% for code in constant('App\\Badminton\\ClassementFfbad::CODES')|reverse %}
                        <option value="{{ code }}" {{ licencie.classementDouble == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="classementMixte">Classement mixte</label>
                <select name="classementMixte" id="classementMixte">
                    <option value="">-</option>
                    {% for code in constant('App\\Badminton\\ClassementFfbad::CODES')|reverse %}
                        <option value="{{ code }}" {{ licencie.classementMixte == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>
            </div>
            {% if sesEquipes|length %}
                <div>
                    <label for="equipePreferee">Équipe par défaut (interclubs)</label>
                    <select name="equipePreferee" id="equipePreferee">
                        <option value="">-</option>
                        {% for equipe in sesEquipes %}
                            <option value="{{ equipe.id }}" {{ licencie.equipePreferee and licencie.equipePreferee.id == equipe.id ? 'selected' : '' }}>{{ equipe.nom }}</option>
                        {% endfor %}
                    </select>
                    <small style="color: var(--color-text-muted);">
                        Utilisée pour pré-filtrer la liste des rencontres interclubs de ce licencié.
                    </small>
                </div>
            {% endif %}
        {% endif %}

        <h2>Mineur et responsables légaux</h2>
        <div>
            <label for="responsableLegal1">Responsable légal 1 (optionnel)</label>
            <select name="responsableLegal1" id="responsableLegal1">
                <option value="">-</option>
                {% for r in responsablesPossibles %}
                    {% if not licencie or r.id != licencie.id %}
                        <option value="{{ r.id }}" {{ licencie and licencie.responsableLegal1 and licencie.responsableLegal1.id == r.id ? 'selected' : '' }}>{{ r.nomComplet }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="responsableLegal2">Responsable légal 2 (optionnel)</label>
            <select name="responsableLegal2" id="responsableLegal2">
                <option value="">-</option>
                {% for r in responsablesPossibles %}
                    {% if not licencie or r.id != licencie.id %}
                        <option value="{{ r.id }}" {{ licencie and licencie.responsableLegal2 and licencie.responsableLegal2.id == r.id ? 'selected' : '' }}>{{ r.nomComplet }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="personnesAutoriseesRecuperation">Personnes autorisées à récupérer l'enfant (optionnel)</label>
            <textarea name="personnesAutoriseesRecuperation" id="personnesAutoriseesRecuperation" rows="2">{{ licencie ? licencie.personnesAutoriseesRecuperation : '' }}</textarea>
        </div>
        <div>
            <label for="contactUrgenceNom">Contact d'urgence — nom (optionnel)</label>
            <input type="text" name="contactUrgenceNom" id="contactUrgenceNom" value="{{ licencie ? licencie.contactUrgenceNom : '' }}">
        </div>
        <div>
            <label for="contactUrgenceTelephone">Contact d'urgence — téléphone (optionnel)</label>
            <input type="tel" name="contactUrgenceTelephone" id="contactUrgenceTelephone" value="{{ licencie ? licencie.contactUrgenceTelephone : '' }}">
        </div>
        <div>
            <label>
                <input type="checkbox" name="autorisationSortieSeul" value="1" {{ licencie and licencie.autorisationSortieSeul ? 'checked' : '' }}>
                Autorisation de sortie seul(e)
            </label>
        </div>
        <div>
            <label>
                <input type="checkbox" name="droitImage" value="1" {{ licencie and licencie.droitImage ? 'checked' : '' }}>
                Droit à l'image accordé
            </label>
        </div>
        <div>
            <label for="informationsSante">Allergies / informations de santé utiles (optionnel)</label>
            <textarea name="informationsSante" id="informationsSante" rows="3">{{ licencie ? licencie.informationsSante : '' }}</textarea>
            <small style="color: var(--color-text-muted);">
                Donnée sensible : visible uniquement du bureau, des entraîneurs et des responsables
                légaux. À ne renseigner que si c'est utile pour la sécurité de l'enfant.
            </small>
        </div>
        <div>
            <label>
                <input type="checkbox" name="consentementDonneesSante" value="1" {{ licencie and licencie.consentementDonneesSante ? 'checked' : '' }}>
                Le licencié (ou son responsable légal) consent explicitement au traitement de cette
                donnée de santé, conformément à l'article 9 du RGPD — obligatoire si le champ
                ci-dessus est rempli.
            </label>
        </div>

        <button type="submit">{{ licencie ? 'Enregistrer' : "Créer" }}</button>
    </form>

    {% if licencie and parametresClub.urlEffectifMyFfbad %}
        <form id="form-synchroniser-myffbad" method="post" action="{{ path('app_licencie_synchroniser_myffbad', {id: licencie.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('synchroniser-myffbad-' ~ licencie.id) }}">
        </form>
    {% endif %}
{% endblock %}
