{% extends 'base.html.twig' %}

{% block title %}Importer depuis MyFFBaD — Axiobad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        #recherche-import-myffbad { max-width: 320px; margin-bottom: 1rem; }
        @media (max-width: 768px) {
            #recherche-import-myffbad { max-width: 100%; }
        }
    </style>
{% endblock %}

{% block body %}
    <h1>Importer des licenciés depuis MyFFBaD</h1>

    <p><a href="{{ path('app_licencie_index') }}">&laquo; Retour à la liste des licenciés</a></p>

    <p style="color: var(--color-text-muted);">
        Cochez les joueurs à importer, puis validez : ils seront créés sans adresse email (MyFFBaD
        n'en fournit pas). Utilisez ensuite « Envoyer l'invitation » sur la liste des licenciés
        pour renseigner leur email et leur donner accès à leur compte.
        {% if nombreDejaPresents %}
            {{ nombreDejaPresents }} joueur(s) de l'effectif MyFFBaD {{ nombreDejaPresents > 1 ? 'ont' : 'a' }}
            déjà un numéro de licence correspondant à un licencié existant — ils ne sont pas
            proposés ici.
        {% endif %}
    </p>
    <p style="color: var(--color-text-muted); font-size: 0.88rem;">
        La colonne « Catégorie » (mineur/majeur) vient de la catégorie d'âge FFBaD, à titre
        indicatif — MyFFBaD ne fournit pas de date de naissance exacte. Pensez à compléter la date
        de naissance et le(s) responsable(s) légal(aux) des licenciés mineurs après import.
    </p>

    {% if joueurs is empty %}
        <p>Aucun nouveau joueur à importer.</p>
    {% else %}
        <form method="post" action="{{ path('app_licencie_import_myffbad_valider') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('importer-myffbad') }}">

            <div>
                <label for="recherche-import-myffbad">Rechercher</label>
                <input type="search" id="recherche-import-myffbad" placeholder="Nom, prénom, n° de licence...">
            </div>

            <p>
                <button type="button" id="tout-cocher">Tout cocher (visibles)</button>
                <button type="button" id="tout-decocher">Tout décocher (visibles)</button>
            </p>

            <div class="table-scroll">
            <table class="table-cards" id="table-import-myffbad">
                <thead>
                    <tr>
                        <th></th>
                        <th>Prénom</th>
                        <th>Nom</th>
                        <th>N° de licence</th>
                        <th>Catégorie</th>
                        <th>Classement S/D/M</th>
                    </tr>
                </thead>
                <tbody>
                    {% for joueur in joueurs %}
                        <tr>
                            <td>
                                <input class="case-joueur" type="checkbox" name="numerosLicence[]" value="{{ joueur.numeroLicence }}" id="joueur-{{ joueur.numeroLicence }}">
                            </td>
                            <td data-label="Prénom"><label for="joueur-{{ joueur.numeroLicence }}">{{ joueur.prenom }}</label></td>
                            <td data-label="Nom">{{ joueur.nom }}</td>
                            <td data-label="N° de licence">{{ joueur.numeroLicence }}</td>
                            <td data-label="Catégorie">
                                {{ joueur.categorieAge ?? '-' }}
                                {% if joueur.estMineur %}
                                    <span style="color: var(--color-warning);">(mineur)</span>
                                {% endif %}
                            </td>
                            <td data-label="Classement">{{ joueur.classementSimple ?? '-' }} / {{ joueur.classementDouble ?? '-' }} / {{ joueur.classementMixte ?? '-' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>

            <button type="submit">Importer la sélection</button>
        </form>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var input = document.getElementById('recherche-import-myffbad');
            var table = document.getElementById('table-import-myffbad');
            if (!input || !table) { return; }
            var lignes = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));

            function estVisible(tr) {
                return tr.style.display !== 'none';
            }

            input.addEventListener('input', function () {
                var terme = input.value.trim().toLowerCase();
                lignes.forEach(function (tr) {
                    var texte = tr.textContent.toLowerCase();
                    tr.style.display = texte.indexOf(terme) === -1 ? 'none' : '';
                });
            });

            document.getElementById('tout-cocher').addEventListener('click', function () {
                lignes.filter(estVisible).forEach(function (tr) {
                    var c = tr.querySelector('.case-joueur');
                    if (c) { c.checked = true; }
                });
            });
            document.getElementById('tout-decocher').addEventListener('click', function () {
                lignes.filter(estVisible).forEach(function (tr) {
                    var c = tr.querySelector('.case-joueur');
                    if (c) { c.checked = false; }
                });
            });
        })();
    </script>
{% endblock %}
