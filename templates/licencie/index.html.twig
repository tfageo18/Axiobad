{% extends 'base.html.twig' %}

{% block title %}Licenciés — Axiobad{% endblock %}

{% block body %}
    <h1>Licenciés</h1>

    <p><a class="btn-cta" href="{{ path('app_licencie_new') }}">+ Nouveau licencié</a></p>

    <div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Rôles</th>
                <th>Statut</th>
                <th>Classement (S/D/M)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for licencie in licencies %}
                <tr>
                    <td>{{ licencie.nomComplet }}</td>
                    <td>{{ licencie.email }}</td>
                    <td>{{ licencie.roles|join(', ') }}</td>
                    <td>{{ licencie.activationTokenValid ? 'En attente d\'activation' : 'Actif' }}</td>
                    <td>{{ licencie.classementSimple ?? '-' }} / {{ licencie.classementDouble ?? '-' }} / {{ licencie.classementMixte ?? '-' }}</td>
                    <td>
                        <a href="{{ path('app_licencie_edit', {id: licencie.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('app_licencie_classement', {id: licencie.id}) }}" style="display:inline">
                            <button type="submit">Rafraîchir le classement</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6">Aucun licencié.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}
