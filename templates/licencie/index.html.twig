{% extends 'base.html.twig' %}

{% block title %}Licenciés — Axiobad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        #recherche-licencies { max-width: 320px; margin-bottom: 1rem; }
        table.datatable th[data-sort] { cursor: pointer; user-select: none; }
        table.datatable th[data-sort]:hover { color: var(--color-primary); }
        table.datatable th[data-sort]::after { content: ' \2195'; opacity: 0.4; }
        table.datatable th[data-sort].tri-asc::after { content: ' \2191'; opacity: 1; }
        table.datatable th[data-sort].tri-desc::after { content: ' \2193'; opacity: 1; }
        @media (max-width: 768px) {
            #recherche-licencies { max-width: 100%; }
        }
    </style>
{% endblock %}

{% block body %}
    <h1>Licenciés</h1>

    <p><a class="btn-cta" href="{{ path('app_licencie_new') }}">+ Nouveau licencié</a></p>
    <p>
        <a href="{{ path('app_saison_index') }}">Gérer les saisons</a>
        · <a href="{{ path('app_licencie_import') }}">Importer en masse (CSV)</a>
        · <a href="{{ path('app_presence_index') }}">Classement des présences</a>
    </p>

    <form method="get" style="margin-bottom: 1rem;">
        <label for="saison">Saison</label>
        <select name="saison" id="saison" onchange="this.form.submit()">
            {% for s in saisons %}
                <option value="{{ s.id }}" {{ saison and saison.id == s.id ? 'selected' : '' }}>{{ s.libelle }}{{ s.estEnCours ? ' (en cours)' : '' }}</option>
            {% endfor %}
        </select>
    </form>
    {% if not saison %}
        <p class="flash-error">Aucune saison n'est configurée. <a href="{{ path('app_saison_new') }}">En créer une</a> pour suivre les adhésions.</p>
    {% endif %}

    {% if saison %}
        {% set nbImpayes = 0 %}
        {% for licencie in licencies %}
            {% if licencie.email != constant('App\\Entity\\Licencie::EMAIL_ADMIN_DEFAUT') %}
                {% set adhesion = adhesions[licencie.id] is defined ? adhesions[licencie.id] : null %}
                {% if not (adhesion and adhesion.statut in ['PAYEE', 'EXONEREE']) %}
                    {% set nbImpayes = nbImpayes + 1 %}
                {% endif %}
            {% endif %}
        {% endfor %}
        <p>
            {% if nbImpayes > 0 %}
                <span class="flash-error" style="display: inline-block;">
                    ⚠ {{ nbImpayes }} licencié{{ nbImpayes > 1 ? 's' : '' }} n'{{ nbImpayes > 1 ? 'ont' : 'a' }} pas payé son adhésion {{ saison.libelle }}.
                </span>
                <button type="button" id="filtre-impayes" style="margin-left: 0.5rem;">Voir uniquement les impayés</button>
            {% else %}
                <span class="flash-success" style="display: inline-block;">✓ Toutes les adhésions {{ saison.libelle }} sont payées.</span>
            {% endif %}
        </p>
    {% endif %}

    <div>
        <label for="recherche-licencies">Rechercher</label>
        <input type="search" id="recherche-licencies" placeholder="Nom, email, rôle...">
    </div>

    <div class="table-scroll">
    <table class="datatable table-cards" id="table-licencies">
        <thead>
            <tr>
                <th data-sort="text">Nom</th>
                <th data-sort="text">Email</th>
                <th data-sort="text">Rôles</th>
                <th data-sort="text">Compte</th>
                <th data-sort="text">Activation</th>
                {% if saison %}<th>Adhésion {{ saison.libelle }}</th>{% endif %}
                <th>Présence</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for licencie in licencies %}
                {% set adhesion = saison and adhesions[licencie.id] is defined ? adhesions[licencie.id] : null %}
                <tr class="{{ licencie.actif ? '' : 'ligne-inactive' }}" data-payee="{{ (licencie.email == constant('App\\Entity\\Licencie::EMAIL_ADMIN_DEFAUT') or (adhesion and adhesion.statut in ['PAYEE', 'EXONEREE'])) ? '1' : '0' }}">
                    <td data-label="Nom">{{ licencie.nomComplet }}</td>
                    <td data-label="Email">
                        {% if licencie.email %}
                            {{ licencie.email }}
                        {% else %}
                            <span style="color: var(--color-text-muted);">Sans compte</span>
                            {% if licencie.responsablesLegaux|length %}
                                <br><small style="color: var(--color-text-muted);">Resp. {{ licencie.responsablesLegaux|map(r => r.nomComplet)|join(', ') }}</small>
                            {% endif %}
                        {% endif %}
                    </td>
                    <td data-label="Rôles">{{ licencie.roles|join(', ') }}</td>
                    <td data-label="Compte">{{ (licencie.actif ? '<span class="badge-actif">Actif</span>' : '<span class="badge-inactif">Désactivé</span>')|raw }}</td>
                    <td data-label="Activation">
                        {% if not licencie.aUnCompte %}
                            <span style="color: var(--color-text-muted);">Rattaché à un responsable</span>
                        {% elseif not licencie.mustChangePassword %}
                            Activé
                        {% elseif licencie.activationTokenValid %}
                            En attente d'activation
                        {% else %}
                            Invitation expirée
                        {% endif %}
                    </td>
                    {% if saison %}
                        <td data-label="Adhésion {{ saison.libelle }}">
                            {% if licencie.email == constant('App\\Entity\\Licencie::EMAIL_ADMIN_DEFAUT') %}
                                <span style="color: var(--color-text-muted);">Non applicable</span>
                            {% else %}
                                {% set libelleStatut = adhesion ? adhesion.statutLabel : 'En attente' %}
                                {% set couleurStatut = adhesion and adhesion.statut == 'PAYEE' ? 'success' : (adhesion and adhesion.statut == 'EXONEREE' ? 'primary-dark' : 'error') %}
                                <a href="{{ path('app_licencie_adhesion', {id: licencie.id, saison: saison.id}) }}" class="quantite-badge {{ couleurStatut == 'error' ? 'zero' : '' }}" style="text-decoration: none; {{ couleurStatut == 'success' ? 'background: var(--color-success-bg); color: var(--color-success);' : (couleurStatut == 'primary-dark' ? 'background: #eef2ff; color: var(--color-primary-dark);' : '') }}">
                                    {{ libelleStatut }}
                                </a>
                                {% if adhesion and adhesion.montantRestant is not null and adhesion.montantRestant > 0 %}
                                    <br><small style="color: var(--color-text-muted);">Reste {{ adhesion.montantRestant|number_format(2, ',', ' ') }} €</small>
                                {% endif %}
                            {% endif %}
                        </td>
                    {% endif %}
                    <td data-label="Présence">
                        {% set taux = tauxPresence[licencie.id] is defined ? tauxPresence[licencie.id] : null %}
                        <a href="{{ path('app_presence_detail', {id: licencie.id}) }}" style="text-decoration: none;">
                            {% if taux is null %}
                                <span style="color: var(--color-text-muted);">-</span>
                            {% else %}
                                <span class="quantite-badge {{ taux < 50 ? 'zero' : '' }}" style="{{ taux >= 75 ? 'background: var(--color-success-bg); color: var(--color-success);' : '' }}">{{ taux }} %</span>
                            {% endif %}
                        </a>
                    </td>
                    <td class="td-actions">
                        <a href="{{ path('app_licencie_edit', {id: licencie.id}) }}">Modifier</a>
                        {% if licencie.aUnCompte and licencie.mustChangePassword %}
                            <form method="post" action="{{ path('app_licencie_renvoyer_invitation', {id: licencie.id}) }}" style="display:inline">
                                <button type="submit">Renvoyer l'invitation</button>
                            </form>
                        {% endif %}
                        {% if licencie.email == constant('App\\Entity\\Licencie::EMAIL_ADMIN_DEFAUT') %}
                            <span style="font-size: 0.82rem; color: var(--color-text-muted);">Compte administrateur par défaut (protégé)</span>
                        {% else %}
                            <form method="post" action="{{ path('app_licencie_toggle_actif', {id: licencie.id}) }}" style="display:inline">
                                <button type="submit">{{ licencie.actif ? 'Désactiver' : 'Réactiver' }}</button>
                            </form>
                            <form method="post" action="{{ path('app_licencie_delete', {id: licencie.id}) }}" onsubmit="return confirm('Supprimer définitivement ce licencié ?');" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-licencie-' ~ licencie.id) }}">
                                <button type="submit">Supprimer</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="9">Aucun licencié.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var input = document.getElementById('recherche-licencies');
            var table = document.getElementById('table-licencies');
            if (!table) { return; }
            var tbody = table.querySelector('tbody');
            var linesOriginal = Array.prototype.slice.call(tbody.querySelectorAll('tr'));

            input.addEventListener('input', function () {
                var terme = input.value.trim().toLowerCase();
                linesOriginal.forEach(function (tr) {
                    var texte = tr.textContent.toLowerCase();
                    tr.style.display = texte.indexOf(terme) === -1 ? 'none' : '';
                });
            });

            var boutonImpayes = document.getElementById('filtre-impayes');
            if (boutonImpayes) {
                boutonImpayes.addEventListener('click', function () {
                    var actif = boutonImpayes.classList.toggle('actif');
                    boutonImpayes.textContent = actif ? 'Voir tout le monde' : 'Voir uniquement les impayés';
                    linesOriginal.forEach(function (tr) {
                        tr.style.display = (actif && tr.getAttribute('data-payee') === '1') ? 'none' : '';
                    });
                    input.value = '';
                });
            }

            table.querySelectorAll('th[data-sort]').forEach(function (th, index) {
                th.addEventListener('click', function () {
                    var asc = !th.classList.contains('tri-asc');
                    table.querySelectorAll('th[data-sort]').forEach(function (autre) {
                        autre.classList.remove('tri-asc', 'tri-desc');
                    });
                    th.classList.add(asc ? 'tri-asc' : 'tri-desc');

                    var lignes = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
                    lignes.sort(function (a, b) {
                        var va = (a.children[index] ? a.children[index].textContent : '').trim().toLowerCase();
                        var vb = (b.children[index] ? b.children[index].textContent : '').trim().toLowerCase();
                        if (va < vb) { return asc ? -1 : 1; }
                        if (va > vb) { return asc ? 1 : -1; }
                        return 0;
                    });
                    lignes.forEach(function (tr) { tbody.appendChild(tr); });
                });
            });
        })();
    </script>
{% endblock %}
