{% extends 'base.html.twig' %}

{% block title %}Nouveau licencié — Axiobad{% endblock %}

{% block body %}
    <h1>Nouveau licencié</h1>
    <p>Un email d'activation sera envoyé au licencié pour qu'il définisse son mot de passe.</p>

    <form method="post">
        <div>
            <label for="prenom">Prénom</label>
            <input type="text" name="prenom" id="prenom" required>
        </div>
        <div>
            <label for="nom">Nom</label>
            <input type="text" name="nom" id="nom" required>
        </div>
        <div>
            <label for="email">Email</label>
            <input type="email" name="email" id="email" required>
        </div>
        <div>
            <label>
                <input type="checkbox" name="roles[]" value="ROLE_BUREAU">
                Membre du bureau (administrateur)
            </label>
        </div>
        <div>
            <label>
                <input type="checkbox" name="roles[]" value="ROLE_ENTRAINEUR">
                Entraîneur
            </label>
        </div>
        <button type="submit">Créer et envoyer l'invitation</button>
    </form>
{% endblock %}
