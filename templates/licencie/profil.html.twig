{% extends 'base.html.twig' %}

{% block title %}Mon profil — Axiobad{% endblock %}

{% block body %}
    <h1>Mon profil</h1>

    <div style="display: flex; gap: 2rem; align-items: flex-start;">
        <div>
            {% if licencie.photo %}
                <img src="{{ licencie.photo }}" alt="Photo de {{ licencie.nomComplet }}" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%;">
            {% else %}
                <div style="width: 150px; height: 150px; border-radius: 50%; background: var(--color-surface-2); display: flex; align-items: center; justify-content: center;">
                    {{ licencie.prenom|slice(0, 1) }}{{ licencie.nom|slice(0, 1) }}
                </div>
            {% endif %}
        </div>

        <form method="post" enctype="multipart/form-data" style="flex: 1;">
            <input type="hidden" name="_token" value="{{ csrf_token('mon-profil') }}">
            <p><strong>{{ licencie.nomComplet }}</strong></p>

            <div>
                <label for="photo">Photo de profil</label>
                <input type="file" name="photo" id="photo" accept="image/*">
            </div>
            <div>
                <label for="email">Email</label>
                <input type="email" name="email" id="email" value="{{ licencie.email }}" required>
            </div>
            <div>
                <label for="telephone">Téléphone</label>
                <input type="tel" name="telephone" id="telephone" value="{{ licencie.telephone }}">
            </div>
            <div>
                <label>
                    <input type="checkbox" name="notificationsActivees" value="1" {{ licencie.notificationsActivees ? 'checked' : '' }}>
                    Recevoir les notifications automatiques par email (rappels de réponse à un
                    créneau, promotion de liste d'attente, cordage prêt, adhésion impayée...)
                </label>
                <p style="color: var(--color-text-muted); font-size: 0.85rem; margin: 0.25rem 0 0;">
                    Ne concerne pas les emails essentiels (activation de compte) ni les
                    communications envoyées manuellement par le bureau.
                </p>
            </div>
            <div>
                <label for="genre">Genre (optionnel)</label>
                <select name="genre" id="genre">
                    <option value="">-</option>
                    {% for valeur, libelle in constant('App\\Entity\\Licencie::GENRES') %}
                        <option value="{{ valeur }}" {{ licencie.genre == valeur ? 'selected' : '' }}>{{ libelle }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="dateNaissance">Date de naissance</label>
                <input type="date" name="dateNaissance" id="dateNaissance" value="{{ licencie.dateNaissance ? licencie.dateNaissance|date('Y-m-d') : '' }}">
                {% if licencie.age is not null %}
                    <small>Âge : {{ licencie.age }} ans ({{ licencie.categorie == 'ENFANT' ? 'enfant' : 'adulte' }})</small>
                {% endif %}
            </div>
            <div>
                <label for="numeroLicence">Numéro de licence FFBaD</label>
                <input type="text" name="numeroLicence" id="numeroLicence" value="{{ licencie.numeroLicence }}">
            </div>
            <div>
                <label for="classementSimple">Classement simple</label>
                <select name="classementSimple" id="classementSimple">
                    <option value="">-</option>
                    {% for code in constant('App\\Badminton\\ClassementFfbad::CODES')|reverse %}
                        <option value="{{ code }}" {{ licencie.classementSimple == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="classementDouble">Classement double</label>
                <select name="classementDouble" id="classementDouble">
                    <option value="">-</option>
                    {% for code in constant('App\\Badminton\\ClassementFfbad::CODES')|reverse %}
                        <option value="{{ code }}" {{ licencie.classementDouble == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="classementMixte">Classement mixte</label>
                <select name="classementMixte" id="classementMixte">
                    <option value="">-</option>
                    {% for code in constant('App\\Badminton\\ClassementFfbad::CODES')|reverse %}
                        <option value="{{ code }}" {{ licencie.classementMixte == code ? 'selected' : '' }}>{{ code }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit">Enregistrer</button>
        </form>
    </div>

    <p><a href="{{ path('app_change_password') }}">Changer mon mot de passe</a></p>

    <h2>Mes données personnelles (RGPD)</h2>
    <p>
        <a href="{{ path('app_mon_profil_export') }}">Télécharger mes données</a> (droit à la
        portabilité) — export au format JSON de toutes les données vous concernant.
    </p>
    {% if licencie.suppressionDemandeeLe %}
        <p style="color: var(--color-text-muted);">
            Vous avez demandé la suppression de votre compte le
            {{ licencie.suppressionDemandeeLe|date('d/m/Y') }}. Le bureau traitera votre demande
            prochainement.
        </p>
    {% else %}
        <form method="post" action="{{ path('app_mon_profil_demander_suppression') }}" onsubmit="return confirm('Demander la suppression définitive de votre compte et de toutes vos données ? Le bureau devra valider cette demande.');">
            <input type="hidden" name="_token" value="{{ csrf_token('demander-suppression') }}">
            <button type="submit">Demander la suppression de mon compte</button>
        </form>
    {% endif %}
    <p><a href="{{ path('app_confidentialite') }}">Politique de confidentialité</a></p>

    <h2>Notifications push sur cet appareil</h2>
    <p id="push-etat" style="color: var(--color-text-muted);">Vérification...</p>
    <button type="button" id="push-activer" style="display:none;">Activer les notifications push sur cet appareil</button>
    <button type="button" id="push-desactiver" style="display:none;">Désactiver les notifications push sur cet appareil</button>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var vapidPublicKey = '{{ vapid_public_key|default('')|e('js') }}';
            var etat = document.getElementById('push-etat');
            var btnActiver = document.getElementById('push-activer');
            var btnDesactiver = document.getElementById('push-desactiver');

            function urlBase64ToUint8Array(base64String) {
                var padding = '='.repeat((4 - base64String.length % 4) % 4);
                var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
                var rawData = window.atob(base64);
                var outputArray = new Uint8Array(rawData.length);
                for (var i = 0; i < rawData.length; ++i) {
                    outputArray[i] = rawData.charCodeAt(i);
                }
                return outputArray;
            }

            function poster(url, corps) {
                return fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(corps),
                });
            }

            if (!vapidPublicKey || !('serviceWorker' in navigator) || !('PushManager' in window)) {
                etat.textContent = vapidPublicKey
                    ? "Les notifications push ne sont pas prises en charge par cet appareil/navigateur."
                    : "Les notifications push ne sont pas configurées sur ce serveur.";
                return;
            }

            navigator.serviceWorker.ready.then(function (registration) {
                registration.pushManager.getSubscription().then(function (abonnement) {
                    if (abonnement) {
                        etat.textContent = 'Les notifications push sont activées sur cet appareil.';
                        btnDesactiver.style.display = 'inline-block';
                    } else {
                        etat.textContent = "Les notifications push sont désactivées sur cet appareil.";
                        btnActiver.style.display = 'inline-block';
                    }
                });

                btnActiver.addEventListener('click', function () {
                    Notification.requestPermission().then(function (permission) {
                        if (permission !== 'granted') {
                            etat.textContent = 'Autorisation refusée par le navigateur.';
                            return;
                        }

                        registration.pushManager.subscribe({
                            userVisibleOnly: true,
                            applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
                        }).then(function (abonnement) {
                            return poster('{{ path('app_push_abonner') }}', abonnement.toJSON());
                        }).then(function () {
                            etat.textContent = 'Les notifications push sont activées sur cet appareil.';
                            btnActiver.style.display = 'none';
                            btnDesactiver.style.display = 'inline-block';
                        }).catch(function () {
                            etat.textContent = "Impossible d'activer les notifications push.";
                        });
                    });
                });

                btnDesactiver.addEventListener('click', function () {
                    registration.pushManager.getSubscription().then(function (abonnement) {
                        if (!abonnement) {
                            return;
                        }
                        var endpoint = abonnement.endpoint;
                        abonnement.unsubscribe().then(function () {
                            return poster('{{ path('app_push_desabonner') }}', { endpoint: endpoint });
                        }).then(function () {
                            etat.textContent = "Les notifications push sont désactivées sur cet appareil.";
                            btnDesactiver.style.display = 'none';
                            btnActiver.style.display = 'inline-block';
                        });
                    });
                });
            });
        })();
    </script>
{% endblock %}
