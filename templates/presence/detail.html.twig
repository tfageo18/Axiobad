{% extends 'base.html.twig' %}

{% block title %}Présences — {{ licencie.nomComplet }} — Axiobad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .recap-presence { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 1rem 0 1.5rem; }
        .recap-presence div { background: var(--color-surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 0.85rem 1.25rem; }
        .recap-presence strong { display: block; font-size: 1.4rem; color: var(--color-primary-dark); }
        .recap-presence small { color: var(--color-text-muted); }
        .graphique-presence {
            background: var(--color-surface);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            overflow-x: auto;
        }
        .graphique-presence svg { display: block; }
        .badge-present { background: var(--color-success-bg); color: var(--color-success); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700; }
        .badge-absent { background: var(--color-error-bg); color: var(--color-error); padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.8rem; font-weight: 700; }
    </style>
{% endblock %}

{% block body %}
    <p><a href="{{ path('app_presence_index') }}">&laquo; Retour aux présences</a></p>

    <h1>Présences de {{ licencie.nomComplet }}</h1>

    {% if licencie.estMineur or licencie.responsablesLegaux|length or licencie.contactUrgenceNom or licencie.informationsSante or licencie.personnesAutoriseesRecuperation %}
        <div class="recap-presence" style="display: block;">
            <h3 style="margin-top: 0;">Informations utiles (mineur)</h3>
            {% if licencie.responsablesLegaux|length %}
                <p><strong>Responsable(s) légal(aux)</strong> : {{ licencie.responsablesLegaux|map(r => r.nomComplet ~ (r.telephone ? ' (' ~ r.telephone ~ ')' : ''))|join(', ') }}</p>
            {% endif %}
            {% if licencie.personnesAutoriseesRecuperation %}
                <p><strong>Personnes autorisées à récupérer l'enfant</strong> : {{ licencie.personnesAutoriseesRecuperation }}</p>
            {% endif %}
            {% if licencie.contactUrgenceNom or licencie.contactUrgenceTelephone %}
                <p><strong>Contact d'urgence</strong> : {{ licencie.contactUrgenceNom ?? '-' }} {{ licencie.contactUrgenceTelephone ? '(' ~ licencie.contactUrgenceTelephone ~ ')' : '' }}</p>
            {% endif %}
            <p><strong>Autorisation de sortie seul(e)</strong> : {{ licencie.autorisationSortieSeul ? 'Oui' : 'Non' }} · <strong>Droit à l'image</strong> : {{ licencie.droitImage ? 'Oui' : 'Non' }}</p>
            {% if licencie.informationsSante %}
                <p style="color: var(--color-error);"><strong>Allergies / santé</strong> : {{ licencie.informationsSante }}</p>
            {% endif %}
        </div>
    {% endif %}

    <div class="recap-presence">
        <div><small>Séances (présent)</small><strong>{{ nombreSeances }}</strong></div>
        <div><small>Réponses données</small><strong>{{ nombreReponses }}</strong></div>
        <div><small>Taux de présence</small><strong>{{ taux is null ? '-' : taux ~ ' %' }}</strong></div>
    </div>

    <h2>6 derniers mois</h2>
    <div class="graphique-presence">
        {% set largeurBarre = 48 %}
        {% set espace = 24 %}
        {% set hauteurMax = 140 %}
        {% set largeurTotale = mois|length * (largeurBarre + espace) %}
        <svg width="{{ largeurTotale }}" height="{{ hauteurMax + 40 }}" viewBox="0 0 {{ largeurTotale }} {{ hauteurMax + 40 }}">
            {% for m in mois %}
                {% set hauteurVenus = maxMois > 0 ? (m.venus / maxMois * hauteurMax)|round(0, 'ceil') : 0 %}
                {% set hauteurTotal = maxMois > 0 ? (m.total / maxMois * hauteurMax)|round(0, 'ceil') : 0 %}
                {% set x = loop.index0 * (largeurBarre + espace) + espace / 2 %}
                <rect x="{{ x }}" y="{{ hauteurMax - hauteurTotal }}" width="{{ largeurBarre }}" height="{{ hauteurTotal }}" fill="var(--color-border)" rx="4"></rect>
                <rect x="{{ x }}" y="{{ hauteurMax - hauteurVenus }}" width="{{ largeurBarre }}" height="{{ hauteurVenus }}" fill="var(--color-success)" rx="4"></rect>
                <text x="{{ x + largeurBarre / 2 }}" y="{{ hauteurMax - hauteurTotal - 6 }}" text-anchor="middle" font-size="12" fill="var(--color-text)">{{ m.venus }}/{{ m.total }}</text>
                <text x="{{ x + largeurBarre / 2 }}" y="{{ hauteurMax + 18 }}" text-anchor="middle" font-size="12" fill="var(--color-text-muted)">{{ m.label }}</text>
            {% endfor %}
        </svg>
        <p style="font-size: 0.82rem; color: var(--color-text-muted); margin: 0.5rem 0 0;">
            <span style="display:inline-block; width:0.7rem; height:0.7rem; background:var(--color-success); border-radius:2px; vertical-align:middle;"></span> présent
            &nbsp;<span style="display:inline-block; width:0.7rem; height:0.7rem; background:var(--color-border); border-radius:2px; vertical-align:middle;"></span> total des réponses
        </p>
    </div>

    <h2>Historique complet ({{ presences|length }})</h2>
    {% if presences|length %}
        <div class="table-scroll">
        <table class="table-cards">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Créneau</th>
                    <th>Réponse</th>
                </tr>
            </thead>
            <tbody>
                {% for presence in presences %}
                    <tr>
                        <td data-label="Date">{{ presence.date|date('d/m/Y') }}</td>
                        <td data-label="Créneau">{{ presence.creneau.nom }}</td>
                        <td data-label="Réponse">
                            {{ (presence.present ? '<span class="badge-present">Présent</span>' : '<span class="badge-absent">Absent</span>')|raw }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% else %}
        <p>Aucune réponse enregistrée pour l'instant.</p>
    {% endif %}
{% endblock %}
