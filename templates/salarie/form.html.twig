{% extends 'base.html.twig' %}

{% block title %}{{ salarie ? 'Modifier' : 'Nouveau' }} salarié — Axiobad{% endblock %}

{% block body %}
    <h1>{{ salarie ? 'Modifier le salarié' : 'Nouveau salarié' }}</h1>

    <form method="post" action="{{ salarie ? path('app_salarie_edit', {id: salarie.id}) : path('app_salarie_new') }}">
        <div>
            <label for="licencie">Licencié du club (optionnel)</label>
            <select name="licencie" id="licencie">
                <option value="">-</option>
                {% for l in licencies %}
                    <option value="{{ l.id }}" data-prenom="{{ l.prenom }}" data-nom="{{ l.nom }}" data-telephone="{{ l.telephone }}" data-email="{{ l.email }}" {{ salarie and salarie.licencie and salarie.licencie.id == l.id ? 'selected' : '' }}>{{ l.nomComplet }}</option>
                {% endfor %}
            </select>
            <small style="color: var(--color-text-muted);">
                Un salarié peut aussi être licencié du club (ex. entraîneur salarié) — le lier ici préremplit les champs ci-dessous. Purement informatif : aucun droit RH n'est accordé au compte licencié.
            </small>
        </div>
        <div>
            <label for="prenom">Prénom</label>
            <input type="text" name="prenom" id="prenom" value="{{ salarie ? salarie.prenom : '' }}" required>
        </div>
        <div>
            <label for="nom">Nom</label>
            <input type="text" name="nom" id="nom" value="{{ salarie ? salarie.nom : '' }}" required>
        </div>
        <div>
            <label for="poste">Poste</label>
            <input type="text" name="poste" id="poste" value="{{ salarie ? salarie.poste : '' }}" placeholder="Ex. Entraîneur salarié, Secrétariat..." required>
        </div>
        <div>
            <label for="typeContrat">Type de contrat</label>
            <select name="typeContrat" id="typeContrat">
                {% for code, libelle in typesContrat %}
                    <option value="{{ code }}" {{ salarie and salarie.typeContrat == code ? 'selected' : '' }}>{{ libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="dateDebut">Date de début (optionnel)</label>
            <input type="date" name="dateDebut" id="dateDebut" value="{{ salarie and salarie.dateDebut ? salarie.dateDebut|date('Y-m-d') : '' }}">
        </div>
        <div>
            <label for="dateFin">Date de fin (optionnel)</label>
            <input type="date" name="dateFin" id="dateFin" value="{{ salarie and salarie.dateFin ? salarie.dateFin|date('Y-m-d') : '' }}">
        </div>
        <div>
            <label for="telephone">Téléphone (optionnel)</label>
            <input type="tel" name="telephone" id="telephone" value="{{ salarie ? salarie.telephone : '' }}">
        </div>
        <div>
            <label for="email">Email (optionnel)</label>
            <input type="email" name="email" id="email" value="{{ salarie ? salarie.email : '' }}">
        </div>
        <div>
            <label for="notes">Notes (optionnel)</label>
            <textarea name="notes" id="notes" rows="4">{{ salarie ? salarie.notes : '' }}</textarea>
        </div>
        <button type="submit">{{ salarie ? 'Enregistrer' : 'Créer' }}</button>
    </form>

    <script>
        (function () {
            var select = document.getElementById('licencie');
            select.addEventListener('change', function () {
                var option = select.options[select.selectedIndex];
                if (!option.value) { return; }
                document.getElementById('prenom').value = option.getAttribute('data-prenom') || '';
                document.getElementById('nom').value = option.getAttribute('data-nom') || '';
                document.getElementById('telephone').value = option.getAttribute('data-telephone') || '';
                document.getElementById('email').value = option.getAttribute('data-email') || '';
            });
        })();
    </script>
{% endblock %}
