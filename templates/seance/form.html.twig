{% extends 'base.html.twig' %}

{% block title %}Séance — {{ creneau.nom }} — {{ date|date('d/m/Y') }} — Axiobad{% endblock %}

{% block body %}
    <p><a href="{{ path('app_creneau_detail', {id: creneau.id, date: date|date('Y-m-d')}) }}">&laquo; Retour au créneau</a></p>

    <h1>Séance — {{ creneau.nom }}</h1>
    <p style="color: var(--color-text-muted);">{{ creneau.jourSemaine }} {{ date|date('d/m/Y') }} · {{ creneau.heureDebut|date('H:i') }} - {{ creneau.heureFin|date('H:i') }} · Encadré par {{ creneau.entraineursLabel }}</p>

    {% if seance.redacteur %}
        <p style="color: var(--color-text-muted); font-size: 0.9rem;">
            Dernière modification par {{ seance.redacteur.nomComplet }}{% if seance.modifieLe %} le {{ seance.modifieLe|date('d/m/Y à H:i') }}{% endif %}.
        </p>
    {% endif %}

    {% if seancePrecedente %}
        <p>
            <a href="{{ path('app_seance_dupliquer', {id: creneau.id, date: date|date('Y-m-d')}) }}">
                📋 Reprendre la séance du {{ seancePrecedente.date|date('d/m/Y') }} comme base
            </a>
        </p>
    {% endif %}

    <form method="post" action="{{ path('app_seance_edit', {id: creneau.id, date: date|date('Y-m-d')}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('seance-edit-' ~ creneau.id ~ '-' ~ date|date('Y-m-d')) }}">

        <div>
            <label for="objectifs">Objectifs de la séance</label>
            <textarea name="objectifs" id="objectifs" rows="3" placeholder="Ex. travail du dégagé, replacement au centre...">{{ seance.objectifs }}</textarea>
        </div>

        <div>
            <label for="contenu">Contenu / exercices</label>
            <textarea name="contenu" id="contenu" rows="10" placeholder="Ex.&#10;- Échauffement 10 min&#10;- Exercice 1 : ... (15 min)&#10;- Exercice 2 : ... (15 min)&#10;- Match dirigé (20 min)">{{ seance.contenu }}</textarea>
        </div>

        <div>
            <label>
                <input type="checkbox" name="publiee" value="1" {{ seance.publiee ? 'checked' : '' }}>
                Publier aux licenciés inscrits à cette séance
            </label>
            <small style="display:block; color: var(--color-text-muted);">
                Une fois publiée, cette séance est visible en lecture seule par les licenciés correspondant à ce créneau, sur la page du créneau.
            </small>
        </div>

        <button type="submit">Enregistrer la séance</button>
    </form>
{% endblock %}
