{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe — Axiobad{% endblock %}

{% block body %}
    <h1>Changer mon mot de passe</h1>

    {% if forced %}
        <p class="flash-error">Vous devez changer votre mot de passe avant de continuer.</p>
    {% endif %}

    <form method="post">
        <div>
            <label for="password">Nouveau mot de passe</label>
            <input type="password" name="password" id="password" minlength="8" required>
        </div>
        <div>
            <label for="confirm_password">Confirmer le mot de passe</label>
            <input type="password" name="confirm_password" id="confirm_password" minlength="8" required>
        </div>
        <button type="submit">Valider</button>
    </form>
{% endblock %}
