{% extends 'base.html.twig' %}

{% block title %}Connexion — Axiobad{% endblock %}

{% block body %}
    <h1>Connexion</h1>

    {% if demo_mode %}
        <div class="demo-banner">
            <p><strong>Instance de démonstration</strong> — données entièrement fictives, réinitialisées régulièrement. Choisissez un compte pour tester :</p>
            <div class="demo-accounts">
                {% for compte in demo_accounts %}
                    <div class="demo-account">
                        <div class="demo-account-role">{{ compte.label }}</div>
                        <div class="demo-account-champ">
                            <span>Email</span>
                            <code>{{ compte.email }}</code>
                        </div>
                        <div class="demo-account-champ">
                            <span>Mot de passe</span>
                            <code>{{ demo_password }}</code>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if error %}
        <p class="flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    {% endif %}

    <form method="post">
        <div>
            <label for="username">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" required autofocus>
        </div>
        <div>
            <label for="password">Mot de passe</label>
            <input type="password" name="_password" id="password" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Se connecter</button>
    </form>

    <p><a href="{{ path('app_mot_de_passe_oublie') }}">Mot de passe oublié ?</a></p>
{% endblock %}
