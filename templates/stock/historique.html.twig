{% extends 'base.html.twig' %}

{% block title %}Historique — {{ titre }} — Axiobad{% endblock %}

{% block body %}
    <h1>Historique — {{ titre }}</h1>
    <p><a href="{{ retour }}">&laquo; Retour au stock</a></p>

    <div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Quantité</th>
                <th>Motif</th>
                <th>Auteur</th>
            </tr>
        </thead>
        <tbody>
            {% for mouvement in mouvements %}
                <tr>
                    <td>{{ mouvement.creeLe|date('d/m/Y H:i') }}</td>
                    <td>{{ mouvement.entree ? 'Entrée' : 'Sortie' }}</td>
                    <td>{{ mouvement.entree ? '+' : '−' }}{{ mouvement.quantite }}</td>
                    <td>{{ mouvement.motif ?? '-' }}</td>
                    <td>{{ mouvement.auteur.nomComplet }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5">Aucun mouvement enregistré.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}
