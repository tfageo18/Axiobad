{% extends 'base.html.twig' %}

{% block title %}Stock — Axiobad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .mouvement-form { display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap; }
        .mouvement-form input[type="number"] { width: 70px; max-width: 70px; }
        .mouvement-form input[type="text"] { width: 140px; max-width: 140px; }
        .mouvement-form button { padding: 0.35rem 0.6rem; font-size: 0.8rem; }
        .btn-entree { background: var(--color-success) !important; }
        .btn-sortie { background: var(--color-error) !important; }
        .quantite-badge {
            display: inline-block;
            min-width: 2rem;
            text-align: center;
            padding: 0.15rem 0.5rem;
            border-radius: 999px;
            font-weight: 700;
            background: var(--color-primary-soft);
            color: var(--color-primary-dark);
        }
        .quantite-badge.zero { background: var(--color-error-bg); color: var(--color-error); }
        .recherche-stock { max-width: 320px; margin-bottom: 1rem; }
    </style>
{% endblock %}

{% block body %}
    <h1>Gestion du stock</h1>

    <p><a href="{{ path('app_inventaire_index') }}">Inventaire du stock</a></p>

    {% set articlesSousLeSeuil = (vetements|filter(v => v.estSousLeSeuil))|merge(volants|filter(v => v.estSousLeSeuil)) %}
    {% if articlesSousLeSeuil|length %}
        <p class="flash-error">
            ⚠ {{ articlesSousLeSeuil|length }} article(s) sous le seuil d'alerte : voir le badge
            rouge ci-dessous.
        </p>
    {% endif %}

    <div>
        <label for="recherche-stock">Rechercher (vêtements et volants)</label>
        <input type="search" id="recherche-stock" class="recherche-stock" placeholder="Type, taille, marque, modèle...">
    </div>

    <h2>Vêtements</h2>
    <p><a class="btn-cta" href="{{ path('app_stock_vetement_new') }}">+ Nouvel article</a></p>
    <div class="table-scroll">
    <table class="table-cards" id="table-stock-vetements">
        <thead>
            <tr>
                <th>Type</th>
                <th>Taille</th>
                <th>Marque</th>
                <th>Lieu de stockage</th>
                <th>En stock</th>
                <th>Mouvement</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for vetement in vetements %}
                <tr>
                    <td data-label="Type">{{ vetement.typeLabel }}</td>
                    <td data-label="Taille">{{ vetement.taille }}</td>
                    <td data-label="Marque">{{ vetement.marque ?? '-' }}</td>
                    <td data-label="Lieu de stockage">{{ vetement.lieuStockage ?? '-' }}</td>
                    <td data-label="En stock">
                        <span class="quantite-badge {{ vetement.quantite == 0 or vetement.estSousLeSeuil ? 'zero' : '' }}">{{ vetement.quantite }}</span>
                        {% if vetement.estSousLeSeuil %}<small title="Seuil d'alerte : {{ vetement.seuilAlerte }}">⚠ sous le seuil</small>{% endif %}
                    </td>
                    <td class="td-mouvement">
                        <form method="post" action="{{ path('app_stock_vetement_mouvement', {id: vetement.id}) }}" class="mouvement-form">
                            <input type="number" name="quantite" min="1" value="1" required>
                            <input type="text" name="motif" placeholder="Motif (optionnel)">
                            <button type="submit" name="type" value="ENTREE" class="btn-entree">+ Entrée</button>
                            <button type="submit" name="type" value="SORTIE" class="btn-sortie">− Sortie</button>
                        </form>
                    </td>
                    <td class="td-actions">
                        <a href="{{ path('app_stock_vetement_historique', {id: vetement.id}) }}">Historique</a>
                        <a href="{{ path('app_stock_vetement_edit', {id: vetement.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('app_stock_vetement_delete', {id: vetement.id}) }}" onsubmit="return confirm('Supprimer cet article ?');" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-stock-vetement-' ~ vetement.id) }}">
                            <button type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7">Aucun article.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>

    <h2>Volants</h2>
    <p><a class="btn-cta" href="{{ path('app_stock_volant_new') }}">+ Nouveau tube</a></p>
    <div class="table-scroll">
    <table class="table-cards" id="table-stock-volants">
        <thead>
            <tr>
                <th>Type</th>
                <th>Vitesse</th>
                <th>Destination</th>
                <th>Marque</th>
                <th>Lieu de stockage</th>
                <th>Modèle</th>
                <th>Tubes en stock</th>
                <th>Mouvement</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for volant in volants %}
                <tr>
                    <td data-label="Type">{{ volant.typeLabel }}</td>
                    <td data-label="Vitesse">{{ volant.vitesse }}</td>
                    <td data-label="Destination">{{ volant.destinationLabel }}</td>
                    <td data-label="Marque">{{ volant.marque ?? '-' }}</td>
                    <td data-label="Lieu de stockage">{{ volant.lieuStockage ?? '-' }}</td>
                    <td data-label="Modèle">{{ volant.modele ?? '-' }}</td>
                    <td data-label="Tubes en stock">
                        <span class="quantite-badge {{ volant.quantiteTubes == 0 or volant.estSousLeSeuil ? 'zero' : '' }}">{{ volant.quantiteTubes }}</span>
                        {% if volant.estSousLeSeuil %}<small title="Seuil d'alerte : {{ volant.seuilAlerte }}">⚠ sous le seuil</small>{% endif %}
                    </td>
                    <td class="td-mouvement">
                        <form method="post" action="{{ path('app_stock_volant_mouvement', {id: volant.id}) }}" class="mouvement-form">
                            <input type="number" name="quantite" min="1" value="1" required>
                            <input type="text" name="motif" placeholder="Motif (optionnel)">
                            <button type="submit" name="type" value="ENTREE" class="btn-entree">+ Entrée</button>
                            <button type="submit" name="type" value="SORTIE" class="btn-sortie">− Sortie</button>
                        </form>
                    </td>
                    <td class="td-actions">
                        <a href="{{ path('app_stock_volant_historique', {id: volant.id}) }}">Historique</a>
                        <a href="{{ path('app_stock_volant_edit', {id: volant.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('app_stock_volant_delete', {id: volant.id}) }}" onsubmit="return confirm('Supprimer ce tube ?');" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-stock-volant-' ~ volant.id) }}">
                            <button type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="9">Aucun tube en stock.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            var input = document.getElementById('recherche-stock');
            if (!input) { return; }
            var tables = ['table-stock-vetements', 'table-stock-volants']
                .map(function (id) { return document.getElementById(id); })
                .filter(Boolean);
            var lignes = [];
            tables.forEach(function (table) {
                lignes = lignes.concat(Array.prototype.slice.call(table.querySelectorAll('tbody tr')));
            });

            input.addEventListener('input', function () {
                var terme = input.value.trim().toLowerCase();
                lignes.forEach(function (tr) {
                    var texte = tr.textContent.toLowerCase();
                    tr.style.display = texte.indexOf(terme) === -1 ? 'none' : '';
                });
            });
        })();
    </script>
{% endblock %}
