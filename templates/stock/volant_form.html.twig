{% extends 'base.html.twig' %}

{% block title %}{{ volant ? 'Modifier' : 'Nouveau' }} tube de volants — Axiobad{% endblock %}

{% block body %}
    <h1>{{ volant ? 'Modifier le tube' : 'Nouveau tube de volants' }}</h1>
    {% if not volant %}
        <p>La quantité en stock se gère ensuite via des mouvements d'entrée/sortie depuis la liste du stock.</p>
    {% endif %}

    <form method="post" action="{{ volant ? path('app_stock_volant_edit', {id: volant.id}) : path('app_stock_volant_new') }}">
        <div>
            <label for="type">Type</label>
            <select name="type" id="type" required>
                {% for valeur, libelle in constant('App\\Entity\\StockVolant::TYPES') %}
                    <option value="{{ valeur }}" {{ volant and volant.type == valeur ? 'selected' : '' }}>{{ libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="vitesse">Vitesse</label>
            <select name="vitesse" id="vitesse" required>
                {% for vitesse in constant('App\\Entity\\StockVolant::VITESSES') %}
                    <option value="{{ vitesse }}" {{ volant and volant.vitesse == vitesse ? 'selected' : '' }}>{{ vitesse }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="destination">Destination</label>
            <select name="destination" id="destination" required>
                {% for valeur, libelle in constant('App\\Entity\\StockVolant::DESTINATIONS') %}
                    <option value="{{ valeur }}" {{ volant and volant.destination == valeur ? 'selected' : '' }}>{{ libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="marque">Marque</label>
            <input type="text" name="marque" id="marque" list="marques-volant" value="{{ volant ? volant.marque : '' }}" placeholder="Choisir ou saisir une marque">
            <datalist id="marques-volant">
                {% for marque in constant('App\\Entity\\StockVolant::MARQUES') %}
                    <option value="{{ marque }}">
                {% endfor %}
            </datalist>
        </div>
        <div>
            <label for="modele">Modèle</label>
            <input type="text" name="modele" id="modele" value="{{ volant ? volant.modele : '' }}" placeholder="ex: Aerosensa 50, Thunder Ace">
        </div>
        <div>
            <label for="prixUnitaire">Prix unitaire € (optionnel, par tube)</label>
            <input type="number" step="0.01" min="0" name="prixUnitaire" id="prixUnitaire" value="{{ volant ? volant.prixUnitaire : '' }}">
        </div>
        <div>
            <label for="commentaire">Commentaire</label>
            <textarea name="commentaire" id="commentaire">{{ volant ? volant.commentaire : '' }}</textarea>
        </div>
        <button type="submit">{{ volant ? 'Enregistrer' : 'Ajouter' }}</button>
    </form>
{% endblock %}
